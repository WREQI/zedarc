@import "/app.wxss";
.mp-loading {
  font-size: 0.32rem;
  line-height: 0;
  position: relative;
  vertical-align: middle;
  z-index: 0;
}
.mp-loading--circle {
  height: 0.213333rem;
  width: 0.213333rem;
}
.mp-loading__spinner {
  animation: mp-rotate 0.8s linear infinite;
  box-sizing: border-box;
  display: inline-block;
  height: 1em;
  position: relative;
  width: 1em;
  z-index: -1;
}
.mp-loading__spinner--spinner {
  animation-timing-function: steps(12);
}
.mp-loading__spinner--spinner .item {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
.mp-loading__spinner--spinner .item:before {
  background-color: currentColor;
  border-radius: 0.053333rem;
  content: " ";
  display: block;
  height: 25%;
  margin: 0 auto;
  width: 0.026667rem;
}
.mp-loading__spinner--spinner .item:nth-child(1) {
  opacity: 1;
  transform: rotate(30deg);
}
.mp-loading__spinner--spinner .item:nth-child(2) {
  opacity: 0.9375;
  transform: rotate(60deg);
}
.mp-loading__spinner--spinner .item:nth-child(3) {
  opacity: 0.875;
  transform: rotate(90deg);
}
.mp-loading__spinner--spinner .item:nth-child(4) {
  opacity: 0.8125;
  transform: rotate(120deg);
}
.mp-loading__spinner--spinner .item:nth-child(5) {
  opacity: 0.75;
  transform: rotate(150deg);
}
.mp-loading__spinner--spinner .item:nth-child(6) {
  opacity: 0.6875;
  transform: rotate(180deg);
}
.mp-loading__spinner--spinner .item:nth-child(7) {
  opacity: 0.625;
  transform: rotate(210deg);
}
.mp-loading__spinner--spinner .item:nth-child(8) {
  opacity: 0.5625;
  transform: rotate(240deg);
}
.mp-loading__spinner--spinner .item:nth-child(9) {
  opacity: 0.5;
  transform: rotate(270deg);
}
.mp-loading__spinner--spinner .item:nth-child(10) {
  opacity: 0.4375;
  transform: rotate(300deg);
}
.mp-loading__spinner--spinner .item:nth-child(11) {
  opacity: 0.375;
  transform: rotate(330deg);
}
.mp-loading__spinner--spinner .item:nth-child(12) {
  opacity: 0.3125;
  transform: rotate(1turn);
}
.mp-loading__spinner--circular {
  animation-duration: 2s;
}
.mp-loading__circular {
  animation: mp-circular 1.5s ease-in-out infinite;
  background-color: red;
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/loading.png);
  background-repeat: no-repeat;
  background-size: 100%;
  height: 100%;
  width: 100%;
}
@-webkit-keyframes mp-circular {
  0% {
    stroke-dasharray: 1, 200;
    stroke-dashoffset: 0;
  }
  50% {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -40;
  }
  to {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -120;
  }
}
@keyframes mp-circular {
  0% {
    stroke-dasharray: 1, 200;
    stroke-dashoffset: 0;
  }
  50% {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -40;
  }
  to {
    stroke-dasharray: 90, 150;
    stroke-dashoffset: -120;
  }
}
@-webkit-keyframes mp-rotate {
  0% {
    transform: rotate(0);
  }
  to {
    transform: rotate(1turn);
  }
}
@keyframes mp-rotate {
  0% {
    transform: rotate(0);
  }
  to {
    transform: rotate(1turn);
  }
}
