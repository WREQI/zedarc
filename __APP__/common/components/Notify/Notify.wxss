.st-notify {
  -webkit-box-align: center;
  -webkit-box-pack: center;
  align-items: center;
  box-sizing: border-box;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  position: relative;
}
.st-notify .mp-popup {
  background-color: initial;
}
.st-notify .st-popup-top .st-popup-content {
  top: -98%;
  transition: all 0.2s ease-in-out;
}
.st-notify__content {
  background: var(--fill-3);
  border: 0.013333rem solid #bcc1cc;
  border-radius: 0.106667rem;
  box-shadow: 0.026667rem 0.026667rem 0.133333rem 0.106667rem
    rgba(31, 32, 34, 0.12);
  color: var(--text-color-1);
  font-size: 0.373333rem;
  margin: 0.346667rem 0.426667rem;
  padding: 0.4rem;
  text-align: left;
}
[data-theme="dark"] .st-notify__content {
  border: 0.013333rem solid var(--border-color-2);
  box-shadow: 0.026667rem 0.026667rem 0.133333rem 0.106667rem
    hsla(0, 0%, 8%, 0.83);
}
.st-notify__title {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  font-size: 0.426667rem;
  font-weight: 500;
  margin-bottom: 0.213333rem;
}
.st-notify__msg {
  line-height: 1.5;
}
.st-notify__bar {
  background: #e9ebf0;
  border-radius: 0.213333rem;
  bottom: 0.533333rem;
  height: 0.08rem;
  left: 50%;
  position: absolute;
  transform: translate(-50%);
  width: 1.493333rem;
}
[data-theme="dark"] .st-notify__bar {
  background: #262e40;
}
.st-notify__icon {
  height: 0.48rem;
  margin-right: 0.213333rem;
  width: 0.48rem;
}
.st-notify__icon--success {
  background: url(data:image/svg+xml;charset=utf-8,%3Csvg\ xmlns=\'http://www.w3.org/2000/svg\'\ viewBox=\'0\ 0\ 36\ 36\'%3E%3Cpath\ d=\'M18\ 0C8.1\ 0\ 0\ 8.1\ 0\ 18s8.1\ 18\ 18\ 18\ 18-8.1\ 18-18S27.9\ 0\ 18\ 0z\'\ fill=\'%233077ec\'/%3E%3Cpath\ d=\'m24.8\ 12-8.4\ 8.4c-.2.2-.6.2-.8\ 0l-3.5-3.5c-.6-.6-1.5-.6-2.1\ 0s-.6\ 1.5\ 0\ 2.1l4.9\ 4.9c.6.6\ 1.5.6\ 2.1\ 0l9.9-9.9c.6-.6.6-1.5\ 0-2.1-.5-.5-1.5-.5-2.1.1z\'\ fill=\'%23fff\'/%3E%3C/svg%3E);
}
.st-notify-fade-enter-active,
.st-notify-fade-leave-active {
  transition: all 0.5s;
}
.st-notify-fade-enter .st-popup-content,
.st-notify-fade-leave-to .st-popup-content {
  top: -109% !important;
  top: calc(-100vh - 1.066667rem) !important;
}
