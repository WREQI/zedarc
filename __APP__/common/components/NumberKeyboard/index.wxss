@import "/app.wxss";
.st-number-keyboard {
  animation-timing-function: ease;
  background-color: var(--fill-2);
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  user-select: none;
  width: 100%;
  z-index: 100;
}
.st-number-keyboard__title {
  background-color: var(--fill-2);
  border-top: 1px solid var(--border-color-1);
  color: var(--text-color-1);
  font-size: 0.426667rem;
  height: 0.8rem;
  line-height: 0.8rem;
  position: relative;
  text-align: center;
}
.st-number-keyboard__title .st-number-keyboard__close {
  color: var(--text-color-4);
  font-size: 0.373333rem;
  left: 0;
  line-height: 0.8rem;
  padding: 0 0.4rem;
  position: absolute;
}
.st-number-keyboard__body {
  box-sizing: border-box;
}
.st-number-keyboard__keys {
  -webkit-box-flex: 3;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  flex: 3;
  flex-wrap: wrap;
}
.st-number-keyboard__sidebar {
  -webkit-box-flex: 1;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  flex: 1;
  flex-direction: column;
}
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(1),
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(2) {
  -webkit-box-flex: 1;
  flex: 1;
  flex-basis: 25%;
}
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(3) {
  -webkit-box-flex: 2;
  flex: 2;
  flex-basis: 50%;
}
.st-number-keyboard__done {
  color: var(--color-blue);
  font-size: 0.373333rem;
  padding: 0 0.426667rem;
  position: absolute;
  right: 0;
}
.st-number-keyboard__custom {
  background-color: var(--fill-1);
}
.st-number-keyboard__custom .st-number-keyboard__body {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  padding: 0.32rem 0.053333rem 0.053333rem 0.32rem;
}
.st-number-keyboard__custom .st-key__wrapper {
  padding: 0 0.266667rem 0.266667rem 0;
}
.st-number-keyboard--embedded {
  padding-bottom: 0;
}
.st-number-keyboard__complex-password {
  background-color: var(--fill-1);
}
.st-number-keyboard__complex-password .st-number-keyboard__body {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  padding: 0.32rem 0.053333rem 0 0.32rem;
}
.st-number-keyboard__complex-password .st-key__wrapper {
  padding: 0 0.266667rem 0.213333rem 0;
}
.st-number-keyboard__complex-password .st-number-key {
  height: 1.2rem;
  line-height: 1.2rem;
}
.st-number-keyboard__complex-password .st-number-keyboard__sidebar {
  padding-left: 0.026667rem;
}
.st-number-key {
  background-color: var(--fill-2);
  border-right: 1px solid var(--border-color-1);
  border-top: 1px solid var(--border-color-1);
  box-sizing: border-box;
  color: var(--text-color-1);
  display: inline-block;
  font-size: 0.64rem;
  font-style: normal;
  height: 1.44rem;
  line-height: 1.44rem;
  text-align: center;
  vertical-align: middle;
  width: 33.3333333333%;
}
.st-number-key:nth-of-type(3n) {
  border-right: none;
}
.st-number-key--delete {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/number-delete.png);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: auto 0.453333rem;
  font-size: 0 !important;
}
[data-theme="dark"] .st-number-key--delete {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/number-delete-black.png);
}
.st-number-key--gray,
.st-number-key:active {
  background-color: var(--border-color-1);
}
.st-key__wrapper {
  -webkit-box-flex: 1;
  box-sizing: border-box;
  flex: 1;
  flex-basis: 33%;
  padding: 0 0.16rem 0.16rem 0;
  position: relative;
}
