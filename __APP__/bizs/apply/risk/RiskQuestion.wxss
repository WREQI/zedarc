@import "/app.wxss";
.comp__risk-question {
  height: 100%;
  width: 100%;
}
.comp__risk-question .question-ask {
  text-align: justify;
  white-space: pre-line;
}
.comp__risk-question .question-ask.fold {
  max-height: 2.986667rem;
  overflow-y: hidden;
  position: relative;
}
.comp__risk-question .question-ask.fold:after {
  background: -webkit-linear-gradient(top, hsla(0, 0%, 100%, 0.1), #fff 67.19%);
  background: linear-gradient(180deg, hsla(0, 0%, 100%, 0.1), #fff 67.19%);
  bottom: 0;
  content: "";
  display: block;
  height: 0.8rem;
  left: 0;
  position: absolute;
  right: 0;
}
[data-theme="dark"] .comp__risk-question .question-ask.fold:after {
  background: -webkit-linear-gradient(
    top,
    rgba(19, 22, 31, 0.1),
    #13161f 67.19%
  );
  background: linear-gradient(180deg, rgba(19, 22, 31, 0.1), #13161f 67.19%);
}
.comp__risk-question .answer-item,
.comp__risk-question .question-ask {
  display: block;
  line-height: 0.6rem;
  padding: 0.266667rem 0.4rem;
}
.comp__risk-question .fold-btn {
  align-self: center;
  border: 1px solid var(--color-primary);
  border-radius: 1.066667rem;
  color: var(--color-primary);
  flex-shrink: 0;
  font-size: 0.32rem;
  height: 0.533333rem;
  margin-bottom: 0.8rem;
  width: 1.466667rem;
}
.comp__risk-question .fold-btn .icon-triangle {
  color: var(--color-primary);
  font-size: 0.16rem;
  transition: all 0.3s ease;
  width: 0.24rem;
}
.comp__risk-question .fold-btn .triangle-up {
  margin-left: 0.133333rem;
  transform: rotate(180deg);
}
.comp__risk-question .fold-btn .triangle-down {
  margin-left: 0.053333rem;
  transform: rotate(0);
}
.comp__risk-question .question-answer-container {
  -webkit-box-flex: 0;
  flex: none;
  overflow-y: scroll;
  padding-bottom: 0.426667rem;
}
.comp__risk-question .question-answer-container::-webkit-scrollbar {
  display: none;
}
.comp__risk-question .question-answer-container .answer-content {
  margin-right: 0.4rem;
}
.comp__risk-question .conflicts {
  line-height: 0.533333rem;
  padding: 0.266667rem 0.4rem 0;
}
.comp__risk-question .weak-conflicts {
  line-height: 0.533333rem;
}
.comp__risk-question .question-tips {
  color: var(--text-color-5);
  font-size: 0.32rem;
  line-height: 0.533333rem;
  padding: 0.4rem;
}
.comp__risk-question .question-tips--bold {
  font-weight: 500;
}
.comp__risk-question .answer-commit-btn {
  padding: 0.4rem 0.4rem 0.4rem 0.426667rem;
}
.comp__risk-question .empty-radio {
  height: 0.32rem;
  margin-right: 0.066667rem;
  transform: scale(0.7);
  width: 0.32rem;
}
.comp__risk-question .empty-checkbox {
  height: 0.666667rem;
  width: 0.773333rem;
}
