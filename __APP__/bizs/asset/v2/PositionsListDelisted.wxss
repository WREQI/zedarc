@import "/app.wxss";
.stock-list--delisted {
  background-color: var(--fill-2);
  margin-bottom: 0.213333rem;
}
.stock-list--delisted .header-marker {
  padding-left: 0.32rem !important;
}
.stock-list--delisted .header-marker:before {
  border-color: transparent transparent #e63535 !important;
  top: calc(50% - 0.026667rem) !important;
  width: 0.24rem !important;
}
.stock-list--delisted .hide-title {
  color: var(--text-color-1);
  font-size: 0.4rem;
  font-weight: 400;
  line-height: 0.586667rem;
}
.stock-list--delisted .hide-desc {
  color: var(--text-color-4);
  font-size: 0.373333rem;
  font-weight: 400;
  line-height: 0.56rem;
}
.stock-list--delisted-item {
  margin: 0 0.4rem;
  padding: 0.32rem 0;
}
.stock-list--delisted-item .stock-name {
  color: var(--text-color-1);
  font-size: 0.426667rem;
  font-weight: 400;
  line-height: 0.586667rem;
}
.stock-list--delisted-item .ico-more {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-more.png);
  background-size: 100%;
  height: 0.586667rem;
  width: 0.586667rem;
}
[data-theme="dark"] .stock-list--delisted-item .ico-more {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-more-dark.png);
}
.stock-list--delisted-item .desc {
  color: var(--text-color-4);
  font-size: 0.373333rem;
  font-weight: 400;
  line-height: 0.56rem;
  padding: 0.16rem 0;
}
.stock-list--delisted-item .desc .tag {
  background: #e9ebf0;
  border-radius: 0.053333rem;
  color: var(--text-color-1);
  font-size: 0.293333rem;
  font-weight: 400;
  line-height: 0.373333rem;
  margin-right: 0.106667rem;
  padding: 0.093333rem 0.106667rem;
  text-align: center;
}
[data-theme="dark"] .stock-list--delisted-item .desc .tag {
  background: #191e27;
}
.stock-list--delisted-item .detail {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.stock-list--delisted-item .detail .text {
  color: var(--color-link);
  font-size: 0.373333rem;
  line-height: 0.533333rem;
}
.stock-list--delisted-item .detail .icon-arrow-link {
  height: 0.32rem;
  padding-left: 0.106667rem;
  width: 0.32rem;
}
.stock-list--delisted__simple-mode {
  margin-bottom: 0;
  padding-top: 0.213333rem;
}
