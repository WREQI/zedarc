  height: 1.706667rem;
}
[data-simple="true"]
  .stock-list-container
  .stock-list-body
  .stock-list-item--extra,
[data-simple="true"]
  .stock-list-container
  .stock-list-body
  .stock-list-item--extra
  .cell,
[data-simple="true"]
  .stock-list-container
  .stock-list-body
  .stock-list-item--extra
  .col-item {
  height: calc(
    1.706667rem + var(--extra-h, 0rem) + var(--drawer-h, 0rem)
  ) !important;
}
.stock-list-container .stock-list-content {
  width: -webkit-fit-content;
  width: fit-content;
}
.stock-list-container .stock-list-content .header-marker {
  padding-left: 0.32rem !important;
}
.stock-list-container .stock-list-body .long-press-base {
  height: 1.6rem;
  left: 2.573333rem;
  position: absolute;
  top: 0;
  width: calc(100% - 2.573333rem);
}
[data-simple="true"] .stock-list-container .stock-list-body .long-press-base {
  height: 1.706667rem;
}
.stock-list-container .stock-list-body .long-press-base-a {
  left: 0 !important;
  width: 2.573333rem;
  z-index: 2;
}
.stock-list-container .stock-list-body .long-press-placeholder {
  background-color: var(--border-color-1);
  opacity: 0;
  transition: all 0.6s ease-in-out;
  z-index: -1;
}
.stock-list-container .stock-list-body .long-press-placeholder--active {
  opacity: 1;
}
.stock-list-container .stock-list-body .long-press-mask {
  background-color: initial !important;
}
@media screen and (min-width: 900px) {
  .stock-list-container .stock-list-content,
  .stock-list-container .uni-scroll-view-content {
    width: 100%;
  }
  .stock-list-container .stock-list-item {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
  }
  .stock-list-container .col-a {
    width: 2.933333rem;
  }
  .stock-list-container .col-b,
  .stock-list-container .col-c,
  .stock-list-container .col-d,
  .stock-list-container .col-e,
  .stock-list-container .col-f,
  .stock-list-container .col-g {
    -webkit-box-flex: 1;
    flex: 1;
  }
}
.stock-list--allocatedebt .col-d {
  padding-right: 0 !important;
}
@media screen and (min-width: 900px) {
  .stock-list--allocatedebt .col-d {
    padding-right: 0.32rem !important;
  }
}
.stock-list--allocatedebt .icon-italic-info {
  padding: 0.106667rem 0 0.106667rem 0.053333rem !important;
}
.stock-list--allocatedebt .cell {
