}
.stock-list--allocatedebt .cell .subtitle {
  color: var(--text-color-4);
  font-size: 0.32rem;
  line-height: 0.453333rem;
  margin-top: 0.053333rem;
}
[data-theme="dark"] .stock-list--allocatedebt .cell .subtitle {
