  -webkit-box-pack: start;
  justify-content: start;
}
.stock-list-container .stock-list-body .col-b,
.stock-list-container .stock-list-body .col-c,
.stock-list-container .stock-list-body .col-d,
.stock-list-container .stock-list-body .col-e,
.stock-list-container .stock-list-body .col-f,
.stock-list-container .stock-list-body .col-g {
  text-align: right;
}
.stock-list-container .stock-list-body .col-f {
  padding-right: 0.266667rem;
}
.stock-list-container .stock-list-body .stock-list-item {
  height: 1.6rem;
  position: relative;
}
.stock-list-container .stock-list-body .stock-list-item--extra,
.stock-list-container .stock-list-body .stock-list-item--extra .cell,
.stock-list-container .stock-list-body .stock-list-item--extra .col-item {
  height: calc(
    1.6rem + var(--extra-h, 0rem) + var(--drawer-h, 0rem)
  ) !important;
}
.stock-list-container .stock-list-body .stock-list-item .mock-border-bottom {
  height: 0.013333rem;
  margin: 0 0.32rem;
  position: absolute;
  width: calc(100% - 0.64rem);
  z-index: 30;
}
.stock-list-container .stock-list-body .stock-list-item .lighter-equa.equal {
  color: var(--text-color-4) !important;
}
.stock-list-container .stock-list-body-gradient {
  background-image: -webkit-linear-gradient(
    left,
    hsla(0, 0%, 100%, 0),
    #fff 0.4rem,
    #fff 0.64rem
  );
  background-image: linear-gradient(
    90deg,
    hsla(0, 0%, 100%, 0),
    #fff 0.4rem,
    #fff 0.64rem
  );
  height: 100%;
  position: absolute;
  right: 0;
  top: 0;
  transform: translateZ(0);
  width: 0.64rem;
  z-index: 35;
}
[data-theme="dark"] .stock-list-container .stock-list-body-gradient {
  background-image: -webkit-linear-gradient(
    left,
    rgba(18, 22, 31, 0),
    #12161f 0.4rem,
    #12161f 0.64rem
  );
  background-image: linear-gradient(
    90deg,
    rgba(18, 22, 31, 0),
    #12161f 0.4rem,
    #12161f 0.64rem
  );
}
[data-simple="true"] .stock-list-container {
  margin-bottom: 0;
}
[data-simple="true"] .stock-list-container .col-a {
  width: 2.573333rem;
}
