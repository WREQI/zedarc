}
.stock-list--allocatedebt .header-marker {
  padding-left: 0.32rem !important;
}
.stock-list--allocatedebt .header-marker:before {
  border-color: transparent transparent #e63535 !important;
  top: calc(50% - 0.026667rem) !important;
  width: 0.24rem !important;
}
.stock-list--allocatedebt .stock-list-body .col-a .stock-market {
  font-size: 0.266667rem;
  margin-right: 0.106667rem;
  margin-top: 0.08rem;
  vertical-align: top;
}
