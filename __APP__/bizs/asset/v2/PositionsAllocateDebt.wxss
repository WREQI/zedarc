  -webkit-box-direction: normal;
  -webkit-box-pack: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: 1.6rem;
  justify-content: center;
}
.stock-list--allocatedebt .cell .title {
