@import "/app.wxss";
.asset-data-container {
  background-color: var(--fill-2);
  padding: 0.373333rem 0.4rem 0.466667rem;
  position: relative;
}
.asset-data-container .fs-40 {
  font-size: 0.533333rem !important;
}
.asset-data-container .fs-36 {
  font-size: 0.48rem !important;
}
.asset-data-container .fs-32 {
  font-size: 0.426667rem !important;
}
.asset-data-container .top-wrap {
  height: 0.533333rem;
  line-height: 0.533333rem;
  padding-bottom: 0.48rem;
}
.asset-data-container .top-wrap .broker-info {
  height: 0.533333rem;
}
.asset-data-container .top-wrap .broker-logo {
  height: 0.533333rem;
  width: 0.533333rem;
}
.asset-data-container .top-wrap .broker-name {
  color: var(--text-color-1);
  font-size: 0.373333rem;
  font-weight: 500;
  padding-left: 0.16rem;
}
.asset-data-container .top-wrap .margin-tag {
  background-color: var(--color-primary);
  border-radius: 0.026667rem;
  color: #fff;
  font-size: 0.293333rem;
  font-weight: 500;
  height: 0.373333rem;
  line-height: 0.373333rem;
  margin-left: 0.106667rem;
  text-align: center;
  width: 0.373333rem;
}
.asset-data-container .top-wrap .broker-account {
  color: var(--text-color-4);
  font-size: 0.32rem;
}
.asset-data-container .top-wrap .line {
  background-color: #c9d0dc;
  height: 0.32rem;
  margin: 0 0.16rem;
  width: 0.013333rem;
}
[data-theme="dark"] .asset-data-container .top-wrap .line {
  background-color: #262e40;
}
.asset-data-container .top-wrap .eye-switch {
  background-color: var(--fill-1);
  border-radius: 0.106667rem;
  color: #576b95;
  padding: 0.093333rem 0.16rem;
}
[data-theme="dark"] .asset-data-container .top-wrap .eye-switch {
  background-color: var(--fill-3);
  color: var(--color-link);
}
.asset-data-container .top-wrap .eye-switch .text {
  font-size: 0.32rem;
  font-weight: 500;
  line-height: 0.453333rem;
}
.asset-data-container .top-wrap .eye {
  background-size: 0.426667rem 0.426667rem;
  height: 0.426667rem;
  width: 0.426667rem;
}
.asset-data-container .top-wrap .eye-link {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-link.png);
  background-repeat: no-repeat;
  margin-right: 0.053333rem;
}
[data-theme="dark"] .asset-data-container .top-wrap .eye-link {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-link-dark.png);
}
.asset-data-container .top-wrap .eye-open {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-open.png);
  background-repeat: no-repeat;
}
[data-theme="dark"] .asset-data-container .top-wrap .eye-open {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-open-dark.png);
}
.asset-data-container .top-wrap .eye-close {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-close.png);
  background-repeat: no-repeat;
}
[data-theme="dark"] .asset-data-container .top-wrap .eye-close {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-eye-close-dark.png);
}
.asset-data-container .top-wrap .icon-arrow-link {
  height: 0.32rem;
  margin-left: 0.106667rem;
  transform: rotate(90deg);
  width: 0.32rem;
}
.asset-data-container .asset-text {
  color: var(--text-color-4);
  font-size: 0.32rem;
  line-height: 0.453333rem;
  padding-bottom: 0.106667rem;
}
.asset-data-container .asset-text .icon-earn-share {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/analysis/share-light.png);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: contain;
  display: inline-block;
  height: 0.32rem;
  margin-left: 0.106667rem;
  width: 0.32rem;
}
[data-theme="dark"] .asset-data-container .asset-text .icon-earn-share {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/analysis/share-dark.png);
}
.asset-data-container .icon-smile {
  font-size: 0.533333rem;
}
.asset-data-container .earn-val-today {
  font-size: 0.64rem;
  font-weight: 500;
  line-height: 0.8rem;
  min-width: 0;
  overflow: hidden;
  word-break: break-all;
}
.asset-data-container .earn-val-today .flex {
  min-width: 0;
}
.asset-data-container .earn-val-today .earn-rate {
  flex-shrink: 0;
  font-size: 0.426667rem;
  line-height: 0.533333rem;
  padding: 0.213333rem 0 0 0.266667rem;
}
.asset-data-container .earn-val-hold {
  font-size: 0.426667rem;
  font-weight: 500;
  line-height: 0.533333rem;
  min-width: 0;
  overflow: hidden;
  padding: 0.213333rem 0 0.066667rem 0.266667rem;
  word-break: break-all;
}
.asset-data-container .money-title {
  color: var(--text-color-4);
  font-size: 0.32rem;
  height: 0.453333rem;
  line-height: 0.453333rem;
  margin-bottom: 0.16rem;
}
.asset-data-container .money-title .icon-arrow-right-new {
  display: inline-block;
  height: 0.32rem;
  padding-left: 0.053333rem;
  width: 0.32rem;
}
.asset-data-container .money-text {
  color: var(--text-color-1);
  font-size: 0.426667rem;
  font-weight: 500;
  line-height: 0.533333rem;
  min-width: 0;
  overflow: hidden;
  word-break: break-all;
}
.asset-data-container .money-summary-row {
  -webkit-box-align: start;
  align-items: flex-start;
}
.asset-data-container .money-summary-row > .flex-1 + .flex-1 {
  margin-left: 0.16rem;
}
.asset-data-container .cash-wrap-content {
  display: inline-block;
}
.asset-data-container .square {
  border-radius: 0.053333rem;
  display: inline-block;
  height: 0.186667rem;
  margin-right: 0.106667rem;
  width: 0.186667rem;
}
.asset-data-container .color-hold {
  background: #e63535;
}
.asset-data-container .color-bal {
  background: #e5a73c;
}
.asset-data-container .color-cash {
  background: #3077ec;
}
.asset-data-container .icon-italic-info {
  font-size: 0.373333rem;
  margin-left: 0.053333rem;
}
.asset-data-container .icon-down-triangle {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/icon-down-triangle.png);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: contain;
  display: inline-block;
  height: 0.12rem;
  margin-left: 0.106667rem;
  width: 0.186667rem;
}
.asset-data-container .progress-bar-placeholder {
  margin-bottom: 0.373333rem;
  padding-top: 0.373333rem;
}
.asset-data-container .value-color-container {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.asset-data-container__simple-mode {
  border-radius: 0.213333rem;
  margin: 0 0.32rem;
  overflow: hidden;
  padding: 0.32rem;
}
.asset-data-container--zxg .earn-val-hold,
.asset-data-container--zxg .earn-val-today .earn-rate,
.asset-data-container--zxg .money-text {
  font-size: 0.48rem;
}
.earn-wrap .earn-rate {
  margin-left: 0.32rem;
}
