      <view class="_div item-title data-v-56bac6f2">预测指标</view>
      <view class="_div detail data-v-56bac6f2">每股收益</view>
      <view class="_div detail data-v-56bac6f2">净利润</view>
      <view class="_div detail data-v-56bac6f2">净利润同比</view>
      <view class="_div detail data-v-56bac6f2">营业收入</view>
      <view class="_div detail data-v-56bac6f2">营业收入同比</view>
      <view class="_div detail data-v-56bac6f2">预测机构家数</view>
    </view>
    <view
      bindtouchcancel="{{CustomScroll.touchend}}"
      bindtouchend="{{CustomScroll.touchend}}"
      bindtouchstart="{{CustomScroll.touchstart}}"
      catchtouchmove="{{CustomScroll.touchmove}}"
      change:scrollOptions="{{CustomScroll.setup}}"
      class="_div indicators-list-wrapper data-v-56bac6f2"
      scrollOptions="{{t}}"
    >
      <view class="_ul indicators-list data-v-56bac6f2">
        <view class="_li list-item data-v-56bac6f2" wx:for="{{r}}" wx:key="h">
          <view class="_div item-title data-v-56bac6f2">{{item.a}}真实值</view>
          <view class="_div detail data-v-56bac6f2">{{item.b}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.c}}亿</view>
          <view class="_div detail data-v-56bac6f2">{{item.d}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.e}}亿</view>
          <view class="_div detail data-v-56bac6f2">{{item.f}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.g}}</view>
        </view>
        <view class="_li list-item data-v-56bac6f2" wx:for="{{s}}" wx:key="h">
          <view class="_div item-title data-v-56bac6f2"
            >{{item.a}}年预测值</view
          >
          <view class="_div detail data-v-56bac6f2">{{item.b}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.c}}亿</view>
          <view class="_div detail data-v-56bac6f2">{{item.d}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.e}}亿</view>
          <view class="_div detail data-v-56bac6f2">{{item.f}}</view>
          <view class="_div detail data-v-56bac6f2">{{item.g}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="_div forcecast-split data-v-56bac6f2"></view>
  <view class="_div update-time data-v-56bac6f2" wx:if="{{v}}"
    >数据时间：{{w}}</view
  >
</view>
