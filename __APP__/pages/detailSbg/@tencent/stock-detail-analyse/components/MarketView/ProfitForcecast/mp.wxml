<view class="_div perfect-forcast data-v-56bac6f2" wx:if="{{a}}">
  <view class="_div title-container data-v-56bac6f2">
    <view class="_div title-text data-v-56bac6f2">盈利预测</view>
    <view class="_div title-tab data-v-56bac6f2">
      <label
        bindtap="{{d}}"
        class="{{['_span','data-v-56bac6f2','tab-item',c]}}"
        wx:if="{{b}}"
        >净利润</label
      >
      <label
        bindtap="{{g}}"
        class="{{['_span','data-v-56bac6f2','tab-item',f]}}"
        wx:if="{{e}}"
        >净利润增速</label
      >
    </view>
  </view>
  <view class="_div sub-title data-v-56bac6f2">{{h}}</view>
  <view
    class="_div perfect-chart-container data-v-56bac6f2"
    id="perfectChart-container"
    wx:if="{{i}}"
  >
    <f2
      bind:__l="__l"
      bindonInit="{{j}}"
      bindtouchend="{{k}}"
      bindtouchmove="{{m}}"
      bindtouchstart="{{l}}"
      class="data-v-56bac6f2"
      uI="56bac6f2-0"
      uP="{{n}}"
      wx:if="{{n}}"
    ></f2>
    <view
      class="{{['_ul','canvas-toolTip','data-v-56bac6f2',q]}}"
      wx:if="{{o}}"
    >
      <view class="_li tips-item data-v-56bac6f2" wx:for="{{p}}" wx:key="c">
        <label class="_span data-v-56bac6f2">{{item.a}}</label>
        <label class="_span data-v-56bac6f2">{{item.b}}</label>
      </view>
    </view>
