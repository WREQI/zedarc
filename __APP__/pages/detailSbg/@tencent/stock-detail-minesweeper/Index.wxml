          catchtap="{{r}}"
          class="_span feedback"
          >问题反馈与建议</label
        >
      </view>
    </block>
    <view class="_div error-block" wx:elif="{{s}}">
      <view class="_p error-pic"></view>
      <view class="_p error-txt">{{t}}</view>
    </view>
  </view>
</view>
