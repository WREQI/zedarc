<view class="_div">
  <view class="_div mod-ms" ref="minesweeperOuter">
    <view class="_p loading" wx:if="{{a}}">加载中...</view>
    <block wx:elif="{{b}}">
      <view class="_div" ref="general">
        <overview
          bind:__l="__l"
          bindfoldChange="{{d}}"
          bindshowGoTop="{{c}}"
          uI="42e9dfce-0"
          uP="{{e}}"
          wx:if="{{e}}"
        ></overview>
      </view>
      <view class="_div" wx:if="{{f}}">
        <news
          bind:__l="__l"
          bindfoldChange="{{h}}"
          class="r"
          uI="42e9dfce-1"
          uP="{{i}}"
          uR="news"
          wx:if="{{i}}"
        ></news>
      </view>
      <view class="_div" wx:if="{{j}}">
        <basic
          bind:__l="__l"
          bindfoldChange="{{l}}"
          class="r"
          uI="42e9dfce-2"
          uP="{{m}}"
          uR="basic"
          wx:if="{{m}}"
        ></basic>
      </view>
      <view class="_div" wx:if="{{n}}">
        <trade
          bind:__l="__l"
          bindfoldChange="{{p}}"
          class="r"
          uI="42e9dfce-3"
          uP="{{q}}"
          uR="trade"
