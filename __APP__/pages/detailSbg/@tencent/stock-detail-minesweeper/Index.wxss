.mod-ms {
  background: var(--fill-2);
}
.gap-line {
  background: var(--fill-1);
  color: var(--color-lightgray-2);
  display: -webkit-flex;
  display: flex;
  font-size: 0.3466666666666667rem;
  justify-content: space-between;
  padding: 0.05333333333333334rem 0.4rem 0.18666666666666668rem;
}
.gap-line span {
  padding-right: 0.4rem;
  position: relative;
}
.gap-line span:after {
  content: "";
  display: inline-block;
  height: 0.26666666666666666rem;
  position: absolute;
  right: 0;
  top: calc(50% - 0.13333333333333333rem);
  width: 0.24rem;
}
.gap-line span.unfoldedall:after {
  background-image: url(https://st.gtimg.com/design/4fb8c91ebea4e91dfbd6d12e6d66537b.png);
  background-repeat: no-repeat;
  background-size: 100%;
}
.gap-line span.foldedall:after {
  background-image: url(https://st.gtimg.com/design/1795b4303c39d9b51161422ea98161c5.png);
  background-repeat: no-repeat;
  background-size: 100%;
}
.warning-info {
  background-color: var(--fill-1);
  color: var(--color-lightgray-2);
  font-size: 0.32rem;
  line-height: 0.5333333333333333rem;
  padding: 0.24rem 0.4rem 1.1466666666666667rem;
}
.warning-info .feedback {
  color: var(--color-midgray-1);
  display: block;
  font-size: 0.32rem;
  margin-top: 0.4rem;
  text-align: center;
}
.loading {
  background: var(--fill-2);
  color: var(--text-color-0);
  font-size: 0.37333333333333335rem;
  height: 8rem;
  padding: 0.26666666666666666rem 0;
  text-align: center;
  width: 100%;
}
.error-block {
  padding: 0.72rem 0 0.26666666666666666rem;
}
.error-block .error-pic {
  background-image: url(https://st.gtimg.com/design/376509596359190bb3d8659a15f185f9.png);
  background-size: 100%;
  height: 1.6266666666666667rem;
  margin: 0 auto 0.24rem;
  width: 1.36rem;
}
.error-block .error-txt {
  color: #6c7eb3;
  font-size: 0.37333333333333335rem;
  margin: 0 auto 0.64rem;
  text-align: center;
}
