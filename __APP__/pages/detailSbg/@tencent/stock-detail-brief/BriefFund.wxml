              >
            </view>
          </view>
          <view class="_div manager-describe data-v-0e348ea9">
            <view class="_div describe-text data-v-0e348ea9">{{item.h}}</view>
          </view>
          <view class="_div h-line data-v-0e348ea9" wx:if="{{item.i}}"></view>
        </view>
      </view>
