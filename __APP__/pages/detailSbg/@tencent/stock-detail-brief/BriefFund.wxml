<view class="{{['_div','mod-brief-fund','data-v-0e348ea9',s&&'skin-black']}}">
  <block wx:if="{{a}}">
    <view class="_div fund-info data-v-0e348ea9" wx:if="{{b}}">
      <view bindtap="{{d}}" class="_div title-wrapper data-v-0e348ea9">
