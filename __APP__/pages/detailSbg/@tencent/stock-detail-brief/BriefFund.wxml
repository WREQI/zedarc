                src="https://st.gtimg.com/design/0f2fffbfcc2c8460ef58a2dffc38577d.svg"
                wx:if="{{title.f}}"
              ></image>
            </block>
            <block wx:else>--</block>
          </view>
          <view class="_div info-content data-v-0e348ea9" wx:else
            >{{title.h}}</view
          >
        </view>
      </view>
    </view>
    <view class="_div fund-manager data-v-0e348ea9" wx:if="{{f}}">
