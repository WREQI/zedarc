        <view class="_i ficon ficon-arrow data-v-0e348ea9" wx:if="{{o}}"></view>
      </view>
      <view class="_div fund-list data-v-0e348ea9">
        <view class="_div fund-list-td data-v-0e348ea9">
          <label class="_span fund-rank-time data-v-0e348ea9">时间</label>
          <label class="_span fund-rank-rate data-v-0e348ea9">份额折算</label>
          <label class="_span fund-rank-rank data-v-0e348ea9">拆分日</label>
