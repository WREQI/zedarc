          <view class="_div info-title data-v-0e348ea9">{{title.a}}</view>
          <view
            bindtap="{{title.g}}"
            class="_div info-index data-v-0e348ea9"
            wx:if="{{title.b}}"
          >
            <block wx:if="{{title.c}}">
              <label class="_span text data-v-0e348ea9">{{title.d}}</label>
              <image
                class="_img triangle data-v-0e348ea9"
                src="https://st.gtimg.com/design/c7cf55384bb059431b60e5f1a2ab115f.svg"
