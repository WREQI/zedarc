          <label class="_span fund-rank-rate data-v-0e348ea9">分红详情</label>
          <label class="_span fund-rank-rank data-v-0e348ea9">派息日</label>
        </view>
        <view
          class="_div fund-list-td fund-list-body data-v-0e348ea9"
          wx:for="{{m}}"
          wx:key="d"
