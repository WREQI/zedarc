        <label class="_span data-v-0e348ea9">基金分红</label>
        <view class="_i ficon ficon-arrow data-v-0e348ea9" wx:if="{{k}}"></view>
      </view>
      <view class="_div fund-list data-v-0e348ea9">
        <view class="_div fund-list-td data-v-0e348ea9">
