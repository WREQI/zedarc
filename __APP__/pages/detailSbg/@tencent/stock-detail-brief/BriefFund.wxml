          src="{{item.b}}"
          wx:if="{{item.a}}"
        ></image>
        <view class="_div img defaultAvatar data-v-0e348ea9" wx:else
          >{{item.c}}</view
        >
        <view class="_div manager-other data-v-0e348ea9">
          <view class="_div manager-basic data-v-0e348ea9">
            <label class="_span name data-v-0e348ea9">{{item.d}}</label>
            <view class="_div right data-v-0e348ea9">
