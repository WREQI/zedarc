.f2-container {
  position: relative;
}
.f2-container .f2-tooltip {
  background-color: #fff;
  border: 0.013333333333333334rem solid #dcdfe6;
  border-radius: 0.10666666666666667rem;
  font-size: 0.26666666666666666rem;
  padding: 0.21333333333333335rem;
  position: absolute;
  top: 0;
}
.f2-container .f2-tooltip.left {
  left: 0;
}
.f2-container .f2-tooltip.right {
  right: 0;
}
.f2-container .f2-tooltip .f2-tooltip-inner {
  color: #262e40;
}
.f2-container .f2-tooltip .f2-tooltip-inner .f2-tooltip-title {
  font-weight: 500;
}
.f2-container .f2-tooltip .f2-tooltip-inner .f2-tooltip-value {
  align-content: center;
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 0.37333333333333335rem;
  justify-content: space-between;
  margin-top: 0.10666666666666667rem;
}
.f2-container
  .f2-tooltip
  .f2-tooltip-inner
  .f2-tooltip-value
  .f2-tooltip-subtitle {
  color: #7a8499;
}
.f2-container
  .f2-tooltip
  .f2-tooltip-inner
  .f2-tooltip-value
  .f2-tooltip-after {
  font-weight: 500;
  margin-left: 0.21333333333333335rem;
}
.f2-canvas {
  height: 100%;
  width: 100%;
}
.hidecanvas {
  display: none;
}
