<view
  bindtap="{{H}}"
  class="{{['_div','data-v-a71936c7','item-container',F,G]}}"
>
  <view class="_div subscribe-container data-v-a71936c7" wx:if="{{a}}">
    <view class="_div subscribe-left data-v-a71936c7">
      <label class="_span subscribe-title data-v-a71936c7">微证券早报</label>
      <view class="_div subscribe-divider data-v-a71936c7"></view>
      <label class="_span subscribe-title data-v-a71936c7"
        >{{b}}万人已订阅</label
      >
    </view>
    <view class="_div subscribe-btn-container data-v-a71936c7">
      <label class="_span has-subscribe data-v-a71936c7" wx:if="{{c}}"
        >已订阅通知</label
      >
      <view catchtap="{{d}}" class="_div subscribe-btn data-v-a71936c7" wx:else>
        <label class="_span subscribe-btn-txt data-v-a71936c7">微信通知</label>
      </view>
    </view>
  </view>
  <image
    class="_img focus-image data-v-a71936c7"
    mode="aspectFill"
    src="{{f}}"
    wx:if="{{e}}"
  ></image>
  <label class="_span news-title data-v-a71936c7" space="ensp">{{g}}</label>
  <view class="_div content-container data-v-a71936c7">
    <label class="_span news-content data-v-a71936c7">{{h}}</label>
    <image
      class="_img thumb-image data-v-a71936c7"
      src="{{j}}"
      wx:if="{{i}}"
    ></image>
  </view>
  <view
    catchtap="{{s}}"
    class="_div related-stock-container data-v-a71936c7"
    wx:if="{{k}}"
  >
    <view class="_div left data-v-a71936c7">
      <image
        class="_img stock-icon data-v-a71936c7"
        src="{{m}}"
        wx:if="{{l}}"
      ></image>
      <label class="_span stock-n data-v-a71936c7">{{n}}</label>
    </view>
    <view class="_div right data-v-a71936c7">
      <label class="{{['_span','data-v-a71936c7','stock-zdf',p]}}">{{o}}</label>
      <view catchtap="{{r}}" class="_div item-right data-v-a71936c7">
        <view
          alt=""
          class="_div add-icon added data-v-a71936c7"
          wx:if="{{q}}"
        ></view>
        <view alt="" class="_div add-icon add data-v-a71936c7" wx:else></view>
      </view>
    </view>
  </view>
  <view class="_div bottom-container data-v-a71936c7">
    <image
      class="_img live-tag data-v-a71936c7"
      mode="aspectFill"
      src="https://st.gtimg.com/design/f3aefb1d0f069de5c1b6df13d97391b9.gif"
      wx:if="{{t}}"
    ></image>
    <label class="_span type-tag data-v-a71936c7" wx:if="{{v}}">直播</label>
    <label class="_span type-tag data-v-a71936c7" wx:elif="{{w}}">早报</label>
    <label class="_span type-tag data-v-a71936c7" wx:elif="{{x}}"
      >直播日历</label
    >
    <label class="_span type-tag data-v-a71936c7" wx:elif="{{y}}">视频</label>
    <label class="_span type-tag data-v-a71936c7" wx:elif="{{z}}">专题</label>
    <label class="_span source data-v-a71936c7">{{A}}</label>
    <label class="_span time data-v-a71936c7">{{B}}</label>
    <label class="_span read-tag data-v-a71936c7" wx:if="{{C}}">已读</label>
    <view catchtap="{{E}}" class="_div share-containter data-v-a71936c7">
      <button
        class="data-v-a71936c7"
        openType="share"
        plain="true"
        style="border: none; background-color: transparent; padding: 0px"
        wx:if="{{D}}"
      >
        <view class="_div share-wrap data-v-a71936c7">
          <image
            class="_img share-icon data-v-a71936c7"
            mode="scaleToFill"
            src="https://st.gtimg.com/design/44be665c48b39c4f2a3ddc8a086c4331.png"
          ></image>
          <label class="_span data-v-a71936c7">分享</label>
        </view>
      </button>
      <view
        class="_div data-v-a71936c7"
        style="border: none; background-color: transparent; padding: 0px"
        wx:else
      >
        <view class="_div share-wrap data-v-a71936c7">
          <image
            class="_img share-icon data-v-a71936c7"
            mode="scaleToFill"
            src="https://st.gtimg.com/design/44be665c48b39c4f2a3ddc8a086c4331.png"
          ></image>
          <label class="_span data-v-a71936c7">分享</label>
        </view>
      </view>
    </view>
  </view>
</view>
