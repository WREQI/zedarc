.asset-all-container .section-item {
  padding: 0.506667rem 0 0;
}
.asset-all-container .header {
  font-size: 0.426667rem;
  font-weight: 500;
  margin-bottom: 0.213333rem;
}
.asset-all-container .item {
  -webkit-box-flex: 1;
  flex: 1;
  padding: 0.293333rem 0 0.4rem;
  text-align: center;
}
.asset-all-container .item:first-child {
  margin-left: 0;
}
.asset-all-container .item:last-child {
  margin-right: 0;
}
.asset-all-container .item.redpoint .item-icon:after {
  background: #f43530;
  border-radius: 50%;
  content: "";
  height: 0.213333rem;
  position: absolute;
  right: -0.106667rem;
  top: -0.106667rem;
  width: 0.213333rem;
}
.asset-all-container .item-icon {
  background-position: 50%;
  background-size: 0.64rem, 0.64rem;
  display: block;
  height: 0.64rem;
  margin-bottom: 0.293333rem;
  position: relative;
  width: 0.64rem;
}
.asset-all-container .item-name {
  color: var(--text-color-1);
  font-size: 0.32rem;
  font-weight: 400;
}
.asset-all-container .entry-wrap {
  flex-wrap: wrap;
}
.asset-all-container .rp-type {
  position: relative;
}
