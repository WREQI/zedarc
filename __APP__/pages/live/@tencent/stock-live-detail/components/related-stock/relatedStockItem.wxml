    <label class="_span addstock-text data-v-a50ce647">{{o}}</label>
  </view>
  <view catchtap="{{r}}" class="_div trade-btn data-v-a50ce647" wx:if="{{q}}">
    <label class="_span trade-text data-v-a50ce647">交易板块</label>
  </view>
  <view catchtap="{{t}}" class="_div trade-btn data-v-a50ce647" wx:elif="{{s}}">
    <label class="_span trade-text data-v-a50ce647">交易指数</label>
  </view>
  <view catchtap="{{w}}" class="_div trade-btn data-v-a50ce647" wx:elif="{{v}}">
    <label class="_span trade-text data-v-a50ce647">立即交易</label>
  </view>
</view>
