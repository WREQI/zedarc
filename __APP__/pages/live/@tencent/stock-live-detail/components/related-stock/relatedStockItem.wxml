        >{{h}}</label
      >
      <label class="_span year-rise-value down data-v-a50ce647" wx:elif="{{i}}"
        >{{j}}</label
      >
      <label class="_span year-rise-value data-v-a50ce647" wx:else>{{k}}</label>
    </view>
  </view>
  <view catchtap="{{n}}" class="_div instock-btn data-v-a50ce647" wx:if="{{m}}">
