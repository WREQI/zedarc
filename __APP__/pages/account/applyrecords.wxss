.apply-records-container {
  background-color: var(--fill-1);
  height: 100vh;
}
.apply-records-container .apply-records-slide-header {
  background-color: var(--fill-2);
  padding-top: 0.2rem;
}
.apply-records-container .swiper-cont {
  height: calc(100vh - 1.2666666666666666rem - env(safe-area-inset-bottom));
}
.apply-records-container .swiper-cont .swiper-item .item-wrapper {
  align-items: center;
  background-color: var(--fill-2);
  display: -webkit-flex;
  display: flex;
  height: 1.6933333333333334rem;
  justify-content: space-between;
  padding: 0 0.4rem 0 0.4533333333333333rem;
  position: relative;
}
.apply-records-container .swiper-cont .swiper-item .item-wrapper.border:before {
  background: var(--border-light);
  content: "";
  height: 0.013333333333333334rem;
  left: 0.4533333333333333rem;
  position: absolute;
  right: 0.4rem;
  top: 0;
}
.apply-records-container .swiper-cont .swiper-item .item-wrapper .broker-logo {
  height: 0.96rem;
  margin-right: 0.29333333333333333rem;
  width: 0.96rem;
}
.apply-records-container .swiper-cont .swiper-item .item-wrapper .broker-name {
  color: var(--color-icon);
  flex: 1;
  font-size: 0.4266666666666667rem;
  font-weight: 500;
  line-height: 0.6rem;
}
.apply-records-container .swiper-cont .swiper-item .item-wrapper .right-button {
  background: var(--color-blue);
  border-radius: 0.10666666666666667rem;
  color: #fff;
  font-size: 0.37333333333333335rem;
  font-weight: 500;
  height: 0.72rem;
  line-height: 0.72rem;
  text-align: center;
  width: 1.88rem;
}
.apply-records-container .swiper-cont .swiper-item .empty {
  align-items: center;
  background-color: var(--fill-2);
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
}
.apply-records-container .swiper-cont .swiper-item .empty .icon {
  background-image: url(https://st.gtimg.com/design/4edfbb8847c6e70b2fe1a59b12f0ec00.png);
  background-repeat: no-repeat;
  background-size: contain;
  height: 2.08rem;
  margin: 1.3333333333333333rem auto 0.7733333333333333rem;
  width: 1.7333333333333334rem;
}
.apply-records-container .swiper-cont .swiper-item .empty .text {
  color: var(--text-color-5);
  font-size: 0.37333333333333335rem;
  margin: 0 auto 0.9066666666666666rem;
  text-align: center;
}
.apply-records-container .swiper-cont .swiper-item .empty .text .link {
  color: var(--color-blue);
}
