@import "/app.wxss";
.bind-bottom-nav {
  -webkit-box-pack: center;
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  padding: 0 0.4rem;
}
.bind-bottom-nav .nav-text {
  font-size: 0.373333rem;
  font-weight: 500;
  line-height: 0.533333rem;
}
.bind-bottom-nav .nav-text + .nav-text {
  margin-left: 0.666667rem;
  position: relative;
}
.bind-bottom-nav .nav-text + .nav-text:before {
  background: #c9d0dc;
  content: "";
  height: 0.32rem;
  left: -0.333333rem;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 0.013333rem;
}
[data-theme="dark"] .bind-bottom-nav .nav-text + .nav-text:before {
  background: #262e40;
}
