page {
  background-color: #efeff4;
}
page .main-content-about {
  background-color: #fff;
}
page .main-content-about .hd-banner-logo {
  border-bottom: 0.013333333333333334rem solid #e5e5e5;
  height: 3.36rem;
  margin: 0 0.4rem;
  position: relative;
  text-align: center;
}
page .main-content-about .hd-banner-logo:after {
  bottom: 0;
  left: 0;
  position: absolute;
  transform: scaleY(0.5);
  transform-origin: 0 100%;
  z-index: 3;
}
page .main-content-about .hd-banner-logo .wrap-logo {
  height: 1.6933333333333334rem;
  width: 1.6933333333333334rem;
}
page .main-content-about .hd-banner-logo .icon-zxg {
  background: url(https://wzq.gtimg.com/resources/images/zxg_logo.png);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  height: 100%;
  width: 100%;
}
page .main-content-about .hd-banner-logo .icon-logo2 {
  color: #007aff;
  font-size: 1.3333333333333333rem;
}
page .main-content-about .bd-text-intro {
  color: #888;
  font-size: 0.37333333333333335rem;
  line-height: 1.3;
  padding: 0.7733333333333333rem 0.4rem 0.9333333333333333rem;
  text-align: justify;
}
page .main-content-about .bd-text-intro .bd-text-h1 {
  color: #000;
  font-size: 0.4266666666666667rem;
  font-weight: 500;
  margin-bottom: 0.24rem;
}
