@import "/app.wxss";
.account-setting {
  height: 100vh;
  height: calc(100vh - env(safe-area-inset-bottom));
}
.account-setting .secure-setting-cell {
  margin-bottom: 0.32rem;
}
.account-setting .secure-setting-cell .border-line {
  margin: 0 0.4rem;
}
.account-setting .secure-setting-cell .st-cell--right-icon,
.account-setting .secure-setting-cell .st-cell--value {
  color: var(--text-color-4);
}
.account-setting .icon-italic-info {
  color: var(--text-color-5);
  margin-left: 0.106667rem;
}
.account-setting .embedded-trade-intro {
  color: var(--text-color-5);
  line-height: 0.453333rem;
  margin: 0.213333rem 0.4rem;
}
.account-setting .title-list-account {
  color: var(--text-color-4);
  font-size: 0.373333rem;
  line-height: 1.066667rem;
  padding: 0 0.4rem;
}
.account-setting .build-version {
  height: 1.333333rem;
  line-height: 1.333333rem;
}
.account-setting .action-sheet-wrap {
  margin-left: 0.4rem;
}
.account-setting .action-sheet-wrap .tip {
  line-height: 1.2;
  margin-bottom: 0.4rem;
  margin-top: 0.453333rem;
}
.account-setting .action-sheet-item {
  -webkit-box-pack: justify;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  padding: 0.4rem 0.4rem 0.4rem 0;
}
.account-setting .action-sheet-item .item-title {
  -webkit-box-flex: 0;
  color: var(--text-color-1);
  flex: 0 0 7.066667rem;
  font-size: 0.426667rem;
  font-weight: 500;
  line-height: 0.426667rem;
  text-align: left;
}
.account-setting .action-sheet-item .icon {
  color: var(--color-blue);
  font-size: 0.306667rem;
}
.account-setting .action-sheet-item .icon-check {
  color: var(--color-primary-2);
}
.account-setting .st-cell--title {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  max-width: none;
}
.account-setting #embedded-trade-dialog .mp-dialog__message {
  max-height: 9.68rem;
}
.account-setting #embedded-trade-dialog .intro-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/embedded-trade-intro.png);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 100%;
  height: 5.44rem;
  margin: 0.426667rem auto 0;
  width: 6.72rem;
}
[data-theme="dark"] .account-setting #embedded-trade-dialog .intro-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/embedded-trade-intro-dark.png);
}
[data-simple="true"] .account-setting #embedded-trade-dialog .intro-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/embedded-trade-intro-light.png);
}
[data-theme="dark"] .close .uni-switch-wrapper .uni-switch-input {
  background-color: #262e40 !important;
  border-color: #262e40 !important;
}
[data-theme="dark"] .close .uni-switch-wrapper .uni-switch-input:before {
  background-color: #262e40;
}
.account-setting .auth-setting {
  background-color: var(--fill-1);
}
.biometrics-tips {
  background: var(--fill-1);
  color: var(--text-color-5);
  font-size: 0.32rem;
  font-weight: 400;
  line-height: 0.48rem;
  padding: 0.213333rem 0.4rem;
}
.biometrics-link {
  color: var(--color-link);
}
.switch-disabled-event {
  pointer-events: none;
}
