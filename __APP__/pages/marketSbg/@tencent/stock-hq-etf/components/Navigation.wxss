.navigation {
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1024;
}
.navigation .mask {
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.navigation .navigation-bar {
  background: transparent;
  height: 1.1733333333333333rem;
  position: relative;
  width: 100%;
}
.navigation .btn-icon {
  color: var(--color-heavygray);
  font-size: 0.5066666666666667rem;
  padding: 0.13333333333333333rem 0.24rem;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1025;
}
.navigation .btn-icon.btn-left {
  left: 0;
}
.navigation .btn-icon.btn-right {
  right: 0;
}
.navigation .btn-icon .icon-btn-back {
  background-image: url(https://st.gtimg.com/design/b1b2e69cc111d399dd0fec7c962a3798.png);
  background-size: cover;
  height: 0.4533333333333333rem;
  width: 0.24rem;
}
[data-theme="dark"] .navigation .btn-icon .icon-btn-back {
  background-image: url(https://st.gtimg.com/design/dc47b047523919cf27831207c2a81881.png);
}
.navigation .icon-back {
  font-size: 0.8533333333333334rem;
  width: 0.25333333333333335rem;
}
.navigation .more-text {
  color: #1c2029;
  font-size: 0.37333333333333335rem;
}
.navigation .mask {
  background: var(--fill-2);
}
.navigation .navigation-title {
  color: var(--color-heavygray);
  font-size: 0.48rem;
  font-weight: 500;
  height: 1.1733333333333333rem;
  width: 100%;
  z-index: 11;
}
.navigation .navigation-title.flex-center {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
}
.navigation-black .icon-btn-back,
.navigation-panda .icon-btn-back {
  color: #98a0b3;
}
.navigation-black .icon-back,
.navigation-panda .icon-back {
  background: #98a0b3;
}
.navigation-black .more-text,
.navigation-panda .more-text {
  color: #98a0b3;
}
.navigation-black .navigation-bar .navigation-title,
.navigation-panda .navigation-bar .navigation-title {
  color: #f0f1f5 !important;
}
.navigation-black .mask,
.navigation-panda .mask {
  background: #1e2126 !important;
}
.navigation-panda.navigation-initial .navigation-bar .navigation-title {
  color: #262e40 !important;
}
.navigation-panda.navigation-initial .icon-btn-back {
  color: var(--color-heavygray) !important;
}
.navigation-panda.navigation-initial .icon-back {
  background: #1c2029 !important;
}
.navigation-panda.navigation-initial .more-text {
  color: #1c2029;
}
