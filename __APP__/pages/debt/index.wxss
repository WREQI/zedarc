@import "/app.wxss";
.debt-index {
  background-color: var(--fill-1);
  min-height: 100vh;
}
.debt-index .placeholder {
  height: 0.32rem;
}
.debt-index .header {
  margin-bottom: 0.16rem;
}
.debt-index .content,
.debt-index .header {
  background-color: var(--fill-2);
}
.debt-index .intro {
  padding: 0.4rem 0.4rem 0.133333rem;
}
.debt-index .top-details .title {
  padding-bottom: 0.266667rem;
}
.debt-index .top-details .value {
  font-size: 1.066667rem;
  font-weight: 500;
  padding-bottom: 0.266667rem;
}
.debt-index .top-value {
  box-sizing: border-box;
  padding-bottom: 0.48rem;
  padding-top: 0.533333rem;
}
.debt-index .top-value .fs-36 {
  font-weight: 500;
  padding-top: 0.106667rem;
}
.debt-index .segment-wrapper {
  background-color: var(--fill-2);
  position: relative;
}
.debt-index .segment-wrapper .st-segment {
  height: 0.96rem;
}
.debt-index .segment-wrapper .st-segment-item {
  -webkit-box-flex: 0;
  border: none;
  color: var(--text-color-2);
  flex: none;
  font-size: 0.4rem;
  line-height: 0.56rem;
  margin: 0 0.133333rem 0 0.4rem;
  width: auto;
}
.debt-index .segment-wrapper .st-segment-item-selected {
  background: none;
  color: var(--text-color-1);
  font-weight: 600;
}
.debt-index .segment-wrapper .st-segment-item-selected:after {
  background: var(--color-primary-1);
  border-radius: 0.04rem;
  bottom: 0.026667rem;
  content: " ";
  height: 0.08rem;
  left: 50%;
  position: absolute;
  transform: translate(-50%);
  width: 0.4rem;
}
.debt-index .segment-wrapper .tips-icon {
  background: url(https://st.gtimg.com/design/f8691032e0a26880cbce416cc2034b28.svg)
    no-repeat;
  background-size: 100% 100%;
  height: 0.48rem;
  position: absolute;
  right: 0.48rem;
  top: 0.24rem;
  width: 0.48rem;
}
[data-theme="dark"] .debt-index .segment-wrapper .tips-icon {
  background: url(https://st.gtimg.com/design/af663237c9bb01ab6c19eb9393885e3c.svg)
    no-repeat;
  background-size: 100% 100%;
}
.debt-index .list-header {
  height: 0.853333rem;
}
.debt-index .list-header .col-item {
  line-height: 0.853333rem;
}
.debt-index .border-bottom {
  border-bottom: none;
}
.debt-index .mp-popup {
  padding-bottom: 0;
}
.debt-index .st-action-sheet-header {
  height: 1.52rem;
}
.debt-index .st-action-sheet-title {
  font-size: 0.48rem;
  font-weight: 600;
  padding: 0.426667rem 0;
}
.debt-index .st-action-sheet-cancel {
  padding-top: 0.64rem;
  right: 0;
}
.debt-index .st-action-sheet-cancel .icon {
  color: var(--text-color-5);
}
.debt-index.simple {
  box-sizing: border-box;
  padding-bottom: 0.4rem;
}
.debt-index.simple .header {
  background: var(--fill-2);
  border-radius: 0.213333rem;
  box-sizing: border-box;
  margin: 0 0.32rem 0.32rem;
}
.debt-index.simple .intro {
  color: var(--text-color-4) !important;
}
.debt-index.simple .intro,
.debt-index.simple .top-details .title {
  font-size: 0.32rem !important;
}
.debt-index.simple .top-details .value {
  font-size: 0.96rem;
}
.debt-index.simple .top-value {
  box-sizing: border-box;
  margin-bottom: 0;
  padding: 0.533333rem 0.32rem 0.4rem;
}
.debt-index.simple .top-value .title {
  line-height: 0.453333rem;
}
.debt-index.simple .top-value .value {
  line-height: 0.666667rem;
  padding-top: 0.106667rem;
}
.debt-index.simple .content {
  background: var(--fill-2);
  border-radius: 0.213333rem;
  box-sizing: border-box;
  margin: 0 0.32rem;
}
.debt-index.simple .segment-wrapper {
  border-top-left-radius: 0.213333rem;
  border-top-right-radius: 0.213333rem;
}
.debt-index.simple .segment-wrapper .st-segment {
  height: 1.173333rem;
}
.debt-index.simple .segment-wrapper .st-segment-item {
  font-size: 0.373333rem;
}
.debt-index.simple .segment-wrapper .st-segment-item-selected {
  font-weight: 500;
}
.debt-index.simple .segment-wrapper .st-segment-item-selected:after {
  bottom: 0.186667rem;
  content: " ";
  width: 0.32rem;
}
.debt-index.simple .segment-wrapper .tips-icon {
  top: 0.32rem;
}
