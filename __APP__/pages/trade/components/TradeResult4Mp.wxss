@import "/app.wxss";
.close-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-close.png);
}
.back-bg,
.close-bg {
  background-repeat: no-repeat;
  background-size: cover;
  height: 0.48rem;
  width: 0.48rem;
}
.back-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-back.svg);
}
.broker-logo-icon-header {
  height: 0.4rem;
  margin-right: 0.16rem;
  width: 0.4rem;
}
.broker-fundaccount {
  color: var(--text-color-1);
  font-size: 0.426667rem;
  line-height: 0.613333rem;
}
.trade-setting {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-setting.png);
  background-repeat: no-repeat;
  background-size: cover;
  height: 0.48rem;
  width: 0.48rem;
}
.trade-result {
  height: 100%;
}
.trade-result .btn {
  margin: 0;
}
.trade-result.trade-result__simple-mode .trade-result--header {
  background-color: var(--fill-2);
  border-top-left-radius: 0.213333rem;
  border-top-right-radius: 0.213333rem;
  color: var(--text-color-1);
  font-size: 0.48rem;
  height: 1.466667rem;
  line-height: 0.666667rem;
  padding: 0 0.32rem;
}
.trade-result.trade-result__simple-mode .buy {
  background: var(--color-buy);
}
.trade-result.trade-result__simple-mode .sell {
  background: var(--color-sell);
}
.trade-result.trade-result__simple-mode .buy,
.trade-result.trade-result__simple-mode .sell {
  color: #fff;
  font-size: 0.426667rem;
  font-weight: 500;
}
.trade-result.trade-result__simple-mode .buy:after,
.trade-result.trade-result__simple-mode .sell:after {
  display: none;
}
.trade-result.trade-result__simple-mode .trade-result--body {
  box-sizing: border-box;
  color: var(--text-color-1);
  padding-top: 3rem;
  position: relative;
}
.trade-result.trade-result__simple-mode .trade-result--body__fail,
.trade-result.trade-result__simple-mode .trade-result--body__simpletheme {
  padding-top: 4.426667rem;
}
.trade-result.trade-result__simple-mode .trade-result--body .status--icon {
  background-color: rgba(28, 170, 60, 0.05);
  border-radius: 50%;
  height: 1.866667rem;
  left: 50%;
  opacity: 0;
  position: absolute;
  top: 2.626667rem;
  transform: translate(-50%) scale(0.8);
  transform-origin: 0;
  width: 1.866667rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .status--icon
  .success {
  background-image: url(https://st.gtimg.com/image/mp-broker/simple/notify/success-green.jpg);
  background-repeat: no-repeat;
  background-size: cover;
  display: block;
  height: 100%;
  width: 0;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .status--icon
  .success.icon-logo-end {
  background-image: url(https://st.gtimg.com/image/mp-broker/simple/notify/sell-end.jpg);
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .status--icon
  .warning {
  background-image: url(https://st.gtimg.com/image/mp-broker/simple/notify/warning.jpg);
  background-repeat: no-repeat;
  background-size: cover;
  display: block;
  height: 0;
  width: 100%;
}
.trade-result.trade-result__simple-mode .trade-result--body .status--text {
  font-size: 0.426667rem;
  font-weight: 500;
  left: 50%;
  line-height: 0.586667rem;
  position: absolute;
  top: 4.92rem;
  transform: translate(-50%);
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .loading-placeholder {
  height: 3.52rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper {
  opacity: 0;
  position: relative;
  transform: translateY(1.213333rem);
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .total-money {
  font-size: 0.826667rem;
  font-weight: 600;
  line-height: 0.586667rem;
  margin-bottom: 0.4rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .order-text {
  font-size: 0.426667rem;
  font-weight: 400;
  line-height: 0.586667rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .name,
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .quantity {
  padding: 0 0.4rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .line {
  color: #dcdfe6;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .order-info-tips {
  box-sizing: border-box;
  line-height: 0.426667rem;
  max-height: 1.44rem;
  overflow-y: auto;
  padding: 0 0.706667rem;
  position: absolute;
  top: 0.053333rem;
  width: 100%;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .btn-wrapper {
  padding: 1.706667rem 0.32rem 0.32rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .btn-wrapper
  .buy,
.trade-result.trade-result__simple-mode
  .trade-result--body
  .order-info-wrapper
  .btn-wrapper
  .sell {
  height: 1.173333rem;
  line-height: 1.173333rem;
}
.trade-result.trade-result__simple-mode
  .trade-result--body
  .trade-result--caidai {
  background-image: url(https://st.gtimg.com/image/mp-broker/simple/caidai-new.gif);
  background-position: center -1.333333rem;
  background-size: 100%;
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: -0.8rem;
}
.loading-container {
  border-radius: 50%;
  height: 2.4rem;
  left: 50%;
  position: absolute;
  top: 2.36rem;
  transform: translate(-50%);
  width: 2.4rem;
}
.loading-container.red {
  background: #e63535;
}
.loading-container.green {
  background: #1caa3c;
}
.loading {
  animation: an1 1s linear infinite;
  background-color: initial;
  border-radius: 50%;
  height: 2.453333rem;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 2.453333rem;
}
.circle-1 {
  clip: rect(0, 1.226667rem, 2.453333rem, 0);
}
.circle-1,
.circle-2 {
  background-color: #fff;
  border-radius: 50%;
  height: 2.453333rem;
  position: absolute;
  transform: rotate(0);
  width: 2.453333rem;
}
.circle-2 {
  clip: rect(0, 2.453333rem, 2.453333rem, 1.226667rem);
  animation: an2 1s linear infinite;
  transform: rotate(60deg);
  transition: all 0.3s;
}
.circle-3 {
  background-color: #fff;
  border-radius: 50%;
  height: 2.186667rem;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 2.186667rem;
}
@-webkit-keyframes an1 {
  0% {
    transform: translate(-50%, -50%) rotate(0);
  }
  to {
    transform: translate(-50%, -50%) rotate(1turn);
  }
}
@keyframes an1 {
  0% {
    transform: translate(-50%, -50%) rotate(0);
  }
  to {
    transform: translate(-50%, -50%) rotate(1turn);
  }
}
@-webkit-keyframes an2 {
  0% {
    transform: rotate(60deg);
  }
  50% {
    transform: rotate(160deg);
  }
  to {
    transform: rotate(60deg);
  }
}
@keyframes an2 {
  0% {
    transform: rotate(60deg);
  }
  50% {
    transform: rotate(160deg);
  }
  to {
    transform: rotate(60deg);
  }
}
