@import "/app.wxss";
.trade-tag {
  background: var(--lable-bg);
  border-radius: 0.053333rem;
  color: var(--text-color-2);
  display: inline-block;
  font-size: 0.293333rem;
  font-weight: 400;
  line-height: 0.373333rem;
  margin-left: 0.16rem;
  padding: 0.026667rem 0.106667rem;
}
.trade-detail-container .base-info {
  background-color: var(--fill-2);
  height: 1.333333rem;
  padding: 0 0.4rem;
}
.trade-detail-container .base-info--link {
  color: var(--primary-color);
  min-width: 2.666667rem;
  padding-left: 0.266667rem;
}
.trade-detail-container .base-info .text-color-1 {
  font-weight: 500;
  margin-right: 0.133333rem;
}
.trade-detail-container .stock-name {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  max-width: 3.333333rem;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.trade-detail-container .steps-wraper {
  background-color: var(--fill-2);
  padding: 0.6rem 0;
}
.trade-detail-container .steps-wraper.bottom-line {
  margin-bottom: 0.16rem;
}
.trade-detail-container .steps-wraper .st-steps-item-description {
  color: var(--text-color-5);
  font-size: 0.266667rem;
  line-height: 1.2;
  margin-top: 0.133333rem;
  width: 2.133333rem;
}
.trade-detail-container .steps-wraper .st-steps-item-icon {
  -webkit-box-align: center;
  -webkit-box-pack: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
}
.trade-detail-container .section {
  padding: 0 0.4rem;
}
.trade-detail-container .section-detail {
  background-color: var(--fill-2);
}
.trade-detail-container .section-detail .detail-order-num {
  height: 2.186667rem;
}
.trade-detail-container .section-detail .detail-order-num.single .left {
  padding-right: 0;
}
.trade-detail-container .section-detail .detail-order-num.single .right {
  padding-left: 0;
}
.trade-detail-container .section-detail .detail-order-num.hk {
  height: -webkit-fit-content;
  height: fit-content;
}
.trade-detail-container .section-detail .detail-order-num.hk .left,
.trade-detail-container .section-detail .detail-order-num.hk .right {
  padding-bottom: 0;
}
.trade-detail-container .section-detail .detail-total {
  height: 1.626667rem;
}
.trade-detail-container .section-detail .detail-total .title {
  flex-shrink: 0;
}
.trade-detail-container .section-detail .detail-total .value {
  -webkit-box-flex: 1;
  flex: 1;
  font-size: 0.666667rem;
  font-weight: 500;
  text-align: right;
}
.trade-detail-container .section-detail .left {
  padding: 0.48rem 0.4rem 0.48rem 0;
}
.trade-detail-container .section-detail .right {
  padding: 0.48rem 0 0.48rem 0.4rem;
}
.trade-detail-container .section-detail .flex-1:first-child {
  padding-left: 0;
}
.trade-detail-container .section-detail .flex-1:last-child {
  padding-right: 0;
}
.trade-detail-container .section-detail .avg-price .tip-icon {
  font-size: 0.373333rem;
  line-height: 1.1;
}
.trade-detail-container .section-fees {
  background-color: var(--fill-2);
  margin-top: 0.16rem !important;
}
.trade-detail-container .section-fees .fee {
  padding: 0.24rem 0;
}
.trade-detail-container .section-fees .fee:nth-child(2) {
  padding-top: 0.48rem;
}
.trade-detail-container .section-fees .fee:last-child {
  padding-bottom: 0.48rem;
}
.trade-detail-container .section-fees .fee .tip {
  padding: 0.186667rem 0 0 0.373333rem;
}
.trade-detail-container .section-fees .fee-total {
  box-sizing: border-box;
  height: 1.466667rem;
}
.trade-detail-container .section-fees .fee-total .title {
  font-size: 0.4rem;
}
.trade-detail-container .section-fees .fee-total .value {
  font-size: 0.666667rem;
  font-weight: 500;
}
.trade-detail-container .section-fees .fee-total .value.smaller {
  font-size: 0.426667rem;
}
.trade-detail-container .section-fees .fee-sum-text .tip-icon {
  font-size: 0.373333rem;
  height: unset;
  line-height: 1.1;
  margin-left: 0;
  width: unset;
}
.trade-detail-container .section-fees .bold {
  font-weight: 500;
}
.trade-detail-container .section-tips {
  margin-top: 1.066667rem;
}
.trade-detail-container .section-tips .tip-title {
  font-size: 0.346667rem;
  font-weight: 500;
  line-height: 0.4rem;
  margin-bottom: 0.133333rem;
}
.trade-detail-container .section-tips .tip-content {
  font-size: 0.346667rem;
  line-height: 0.56rem;
}
.trade-detail-container .fees-tips {
  margin-top: 0.64rem;
}
.trade-detail-container .fees-tips .multi-line {
  line-height: 0.453333rem;
  padding: 0 0.426667rem;
  text-align: left;
}
.trade-detail-container .block-button {
  padding: 0.4rem;
}
.trade-detail-container .rate-detail-container {
  margin-top: 0.08rem;
  padding-left: 0.266667rem;
}
.trade-detail-container .rate-detail-text {
  line-height: 0.373333rem;
}
