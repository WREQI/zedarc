@import "/app.wxss";
.close-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-close.png);
}
.back-bg,
.close-bg {
  background-repeat: no-repeat;
  background-size: cover;
  height: 0.48rem;
  width: 0.48rem;
}
.back-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-back.svg);
}
.broker-logo-icon-header {
  height: 0.4rem;
  margin-right: 0.16rem;
  width: 0.4rem;
}
.broker-fundaccount {
  color: var(--text-color-1);
  font-size: 0.426667rem;
  line-height: 0.613333rem;
}
.trade-setting {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-setting.png);
  background-repeat: no-repeat;
  background-size: cover;
  height: 0.48rem;
  width: 0.48rem;
}
.trade-result {
  box-sizing: border-box;
  height: 100%;
  z-index: 100;
}
.trade-result .trade-result--header {
  background-color: var(--fill-2);
  border-top-left-radius: 0.213333rem;
  border-top-right-radius: 0.213333rem;
  color: var(--text-color-1);
  font-size: 0.48rem;
  height: 1.466667rem;
  line-height: 0.666667rem;
  padding: 0 0.32rem;
}
.trade-result .common-result-container .section-result {
  padding-top: 0.733333rem;
}
.trade-result .common-result-container .result-icon {
  height: 1.533333rem;
  width: 1.533333rem;
}
.trade-result .common-result-container .icon-warning {
  font-size: 0.96rem;
}
.trade-result .result-wrapper {
  box-sizing: border-box;
  padding: 1.186667rem 0.4rem 0;
  width: 100%;
}
.trade-result .result-wrapper .result-success {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/result-success.png);
  background-repeat: no-repeat;
  background-size: cover;
  height: 1.866667rem;
  width: 1.866667rem;
}
[data-theme="dark"] .trade-result .result-wrapper .result-success {
  background-image: url(https://st.gtimg.com/image/mp-broker/simple/notify/suc-dark-v2.png);
}
.trade-result .result-wrapper .result-fail {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/result-fail.png);
  background-repeat: no-repeat;
  background-size: cover;
  height: 1.866667rem;
  width: 1.866667rem;
}
.trade-result .result-wrapper .result-title {
  font-size: 0.426667rem;
  font-weight: 500;
  line-height: 0.586667rem;
  padding: 0.48rem 0 0.16rem;
}
.trade-result .result-wrapper .result-desc {
  box-sizing: border-box;
  font-size: 0.32rem;
  height: 1.066667rem;
  line-height: 0.426667rem;
  overflow-y: auto;
  padding: 0 0.4rem;
  text-align: center;
}
.trade-result .btn {
  margin: 0.213333rem 0 0 !important;
  width: 100%;
}
.trade-result .btn.buy {
  background: var(--color-buy) !important;
}
.trade-result .btn.sell {
  background: var(--color-sell) !important;
}
