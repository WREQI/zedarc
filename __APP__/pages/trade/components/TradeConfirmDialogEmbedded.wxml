        <label class="value">{{d}}</label>
      </view>
      <view class="flex-between">
        <label class="label">价格</label>
        <label class="{{['value',g]}}">{{e}}{{f}}</label>
      </view>
      <view class="flex-between">
        <label class="label">数量</label>
        <label class="{{['value',j]}}">{{h}}{{i}}</label>
