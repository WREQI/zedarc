          ></textarea>
          <view
            class="{{['_div','questionnaire__char-count','data-v-b3f780ae',g&&'questionnaire__char-count--limit']}}"
            >{{f}}/200</view
          >
        </view>
      </view>
      <view class="_div questionnaire__footer data-v-b3f780ae">
        <view
          bindtap="{{i}}"
          class="{{['_div','questionnaire__submit-btn','data-v-b3f780ae',h&&'questionnaire__submit-btn--active']}}"
          >提交反馈</view
        >
      </view>
    </view>
  </view>
</view>
