        >
        <view class="_div item-title item-desc-title data-v-0db526ed"
          >股票</view
        >
        <view class="_div item-title item-popvalue-title data-v-0db526ed">
          <label class="_span data-v-0db526ed">{{i}}</label>
        </view>
        <view class="_div item-title item-info-title data-v-0db526ed">
