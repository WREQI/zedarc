            wx:if="{{l}}"
          >
            <label class="_span data-v-0db526ed">{{m}}</label>
          </view>
        </view>
      </view>
      <view class="_div sheet-content-container data-v-0db526ed">
        <view
          bindtap="{{item.i}}"
          class="{{['_div','sheet-container-item','data-v-0db526ed',s&&'sheet-rank-item']}}"
          wx:for="{{o}}"
          wx:key="j"
        >
          <view class="_div item-rank data-v-0db526ed">NO.{{item.a}}</view>
          <view class="_div item-desc data-v-0db526ed">
            <view class="_div name data-v-0db526ed">{{item.b}}</view>
            <view class="_div symbol data-v-0db526ed">{{item.c}}</view>
          </view>
          <view class="_div item-popvalue data-v-0db526ed" wx:if="{{p}}"
            >{{item.d}}</view
          >
          <view
            class="_div item-info data-v-0db526ed"
            style="{{'color:'+item.f}}"
            wx:if="{{q}}"
            >{{item.e}}</view
          >
          <view
            class="_div item-zdf data-v-0db526ed"
            style="{{'color:'+item.h}}"
            wx:if="{{r}}"
            >{{item.g}}%</view
          >
        </view>
      </view>
    </view>
  </view>
</view>
