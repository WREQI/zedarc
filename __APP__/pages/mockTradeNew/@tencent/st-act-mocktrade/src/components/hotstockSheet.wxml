<view class="_div hot-action-sheet data-v-0db526ed">
  <view bindtap="{{b}}" class="{{['_div','data-v-0db526ed',a]}}"></view>
  <view
    class="{{['_div','modal-container','data-v-0db526ed',w&&'modal-show',x&&'rank-modal-container']}}"
  >
    <view
      bindtap="{{v}}"
      class="{{['_div','sheet-container','data-v-0db526ed',t&&'sheet-rank-container']}}"
      wx:if="{{c}}"
    >
