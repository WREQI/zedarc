        >
        <view
          class="{{['_div','data-v-e8242dcd','plate-feature-stock','layout-column','layout-align-space-between','h5-or-wzq-feature-stock']}}"
        >
          <view
            class="_div plate-stock-label data-v-e8242dcd"
            wx:if="{{item.g}}"
          >
            <label
              class="{{['_span','data-v-e8242dcd','plate-label-item',label.c]}}"
              wx:for="{{item.h}}"
              wx:for-item="label"
              wx:key="b"
              >{{label.a}}</label
            >
          </view>
          <view class="_div data-v-e8242dcd" wx:elif="{{item.i}}"
            >规模{{item.j}}</view
          >
        </view>
      </view>
    </view>
  </view>
</view>
