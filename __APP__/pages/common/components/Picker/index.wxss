@import "/app.wxss";
.st-picker-panel {
  background: var(--fill-2);
  height: 7.28rem;
  text-align: center;
  z-index: 102;
}
.st-picker-move-enter,
.st-picker-move-leave-active {
  transform: translate3d(0, 100%, 0);
}
.st-picker-move-enter-active,
.st-picker-move-leave-active {
  transition: all 0.3s ease-in-out;
}
.st-picker-choose {
  height: 1.333333rem;
  position: relative;
}
.st-picker-cancel,
.st-picker-confirm {
  box-sizing: initial;
  line-height: 1.333333rem;
  padding: 0 var(--picker-lr-padding);
}
.st-picker-confirm {
  color: var(--color-primary-1);
  font-size: 0.426667rem;
  position: absolute;
  right: 0.4rem;
}
.st-picker-cancel {
  color: var(--text-color-2);
  font-size: 0.32rem;
  left: 0.4rem;
  position: absolute;
}
.st-picker-title-group {
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-box-pack: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  flex-flow: column;
  height: 100%;
  justify-content: center;
  padding: 0 1.333333rem;
  text-align: center;
}
.st-picker-title {
  color: var(--text-color-1);
  font-size: 0.48rem;
  font-weight: 500;
  line-height: 0.666667rem;
}
.st-picker-subtitle {
  color: var(--color-text-2);
  font-size: 0.32rem;
  line-height: 0.213333rem;
  margin-top: 0.026667rem;
}
.st-picker-content {
  position: relative;
  top: 0.266667rem;
}
.st-picker-content .st-picker-content-border {
  height: 0.906667rem;
  left: 0;
  pointer-events: none;
  position: absolute;
  transform: translateZ(0);
  width: 100%;
  z-index: 10;
}
.st-picker-content > .border-bottom-1px {
  background: var(--picker-gradient);
  top: 0;
}
.st-picker-content > .border-bottom-1px:after {
  background: -webkit-linear-gradient(
    left,
    rgba(48, 119, 236, 0.15),
    #3077ec 50%,
    rgba(48, 119, 236, 0.15)
  );
  background: linear-gradient(
    90deg,
    rgba(48, 119, 236, 0.15),
    #3077ec 50%,
    rgba(48, 119, 236, 0.15)
  );
  border: none;
  height: 0.026667rem;
  left: 50%;
  transform: translate(-1.733333rem) scale(0.5) translateZ(0);
  width: 6.933333rem;
}
.st-picker-content > .border-top-1px {
  background: var(--picker-gradient);
  bottom: 0;
}
.st-picker-content > .border-top-1px:before {
  background: -webkit-linear-gradient(
    left,
    rgba(48, 119, 236, 0.15),
    #3077ec 50%,
    rgba(48, 119, 236, 0.15)
  );
  background: linear-gradient(
    90deg,
    rgba(48, 119, 236, 0.15),
    #3077ec 50%,
    rgba(48, 119, 236, 0.15)
  );
  border: none;
  height: 0.026667rem;
  left: 50%;
  transform: translate(-1.733333rem) scale(0.5) translateZ(0);
  width: 6.933333rem;
}
.st-picker-wheel-wrapper {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  padding: 0 var(--picker-lr-padding);
}
.st-picker-wheel-wrapper > div {
  -webkit-box-flex: 1;
  flex: 1;
  flex-basis: 0;
  font-size: 0.426667rem;
  height: 2.306667rem;
  overflow: hidden;
  width: 1%;
}
.st-picker-wheel-scroll {
  line-height: 0.48rem;
  list-style: none;
  margin-top: 0.906667rem;
  padding: 0;
}
.st-picker-wheel-item {
  color: var(--text-color-1);
  font-size: 0.4rem;
  line-height: 1;
  list-style: none;
  overflow: hidden;
  white-space: nowrap;
}
.st-picker-footer {
  height: 0.266667rem;
}
.uni-picker-view-indicator:after,
.uni-picker-view-indicator:before {
  border-color: var(--border-color-2);
}
