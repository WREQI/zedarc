@import "/app.wxss";
.st-password-input {
  position: relative;
  user-select: none;
}
.st-password-input:focus {
  outline: none;
}
.st-password-input__security {
  background-color: var(--fill-2);
  border: 0.013333rem solid var(--border-color-2);
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  height: 1.173333rem;
  width: 100%;
}
.st-password-input__security .st-password-inpu__item {
  -webkit-box-flex: 1;
  border-right: 0.013333rem solid var(--border-color-2);
  flex: 1;
  height: 100%;
  position: relative;
}
.st-password-input__security .st-password-inpu__item:last-child {
  border-right: 0;
}
.st-password-input__security .st-password-inpu__item:not(:first-of-type):after {
  border-left-width: 0.013333rem;
}
.st-password-input__security .st-password-inpu__item:after {
  border-color: var(--border-color-2);
}
.st-password-input__security .st-password-inpu__item:last-child:after {
  border: none;
}
.st-password-input__security text {
  background-color: var(--text-color-1);
  border-radius: 50%;
  height: 0.266667rem;
  left: 50%;
  margin: -0.133333rem 0 0-0.133333rem;
  position: absolute;
  top: 50%;
  visibility: hidden;
  width: 0.266667rem;
}
.st-password-input__security text.visibility {
  visibility: visible;
}
