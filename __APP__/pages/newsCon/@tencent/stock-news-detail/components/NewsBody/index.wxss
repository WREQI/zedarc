.st-popup.st-modal .st-popup-content .st-modal-title {
  padding-bottom: 0;
}
.st-popup.st-modal .st-popup-content .st-modal-title:after {
  border-bottom-width: 0;
}
.stock-news-container {
  position: relative;
}
.stock-news-container #pdf_download {
  background-color: #3d76b8;
  border-radius: 0.13333333333333333rem;
  display: inline-block;
  float: right;
  height: 0.6933333333333334rem;
  margin-top: -0.08rem;
  width: 2.8533333333333335rem;
}
.stock-news-container .news_description #pdf_download .text {
  color: #fff;
  display: block;
  font-size: 0.3466666666666667rem;
  height: 0.6933333333333334rem;
  line-height: 0.6933333333333334rem;
  margin-left: 1.12rem;
  margin-top: -0.6933333333333334rem;
}
.stock-news-container .emptyNews {
  color: #9599a1;
  font-size: 0.37333333333333335rem;
  margin: 2.6666666666666665rem 0;
  text-align: center;
}
.stock-news-container .emptyNews .emptyImg {
  background: url(data:image/png;base64,)
    no-repeat;
  background-size: contain;
  height: 1.0933333333333333rem;
  margin: 0 auto 0.4rem;
  width: 1.0933333333333333rem;
}
