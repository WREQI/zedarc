.vip-box {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-top: -6.133333333333334rem;
  position: relative;
  width: 100%;
  z-index: 10;
}
.vip-box.no-shadow {
  margin-top: 0;
}
.vip-box .vip-shadow {
  background: linear-gradient(180deg, hsla(0, 0%, 100%, 0), #fff);
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: 6.133333333333334rem;
  justify-content: flex-end;
}
.vip-box .vip-shadow.no-shadow {
  height: 0;
}
.vip-box .vip-text {
  color: #7a8499;
  font-size: 0.4rem;
  line-height: 0.4rem;
  margin-top: 0.5333333333333333rem;
  text-align: center;
}
.vip-box .vip-text.top30 {
  margin-top: 0.4rem;
}
.vip-box .vip-text .more-num {
  color: #3077ec;
}
.vip-box .vip-text .more-num-red {
  color: #e63535;
}
.vip-box .btn-box {
  text-align: center;
}
.vip-box .btn-box .iap-button.sBigBtn,
.vip-box .btn-box .vip-btn {
  background: #3077ec;
  border-radius: 0.10666666666666667rem;
  box-sizing: border-box;
  color: #fff;
  display: inline-block;
  font-size: 0.4266666666666667rem;
  font-weight: 500;
  height: 1.0666666666666667rem;
  line-height: 1.0666666666666667rem;
  margin-top: 0.26666666666666666rem;
  min-width: 4.266666666666667rem;
  padding: 0 0.4666666666666667rem;
  text-align: center;
}
.vip-box .btn-box .mod-iap {
  position: relative;
  text-align: left;
}
.vip-box .btn-box .iap-button-wrapper.sBigBtn {
  text-align: center;
}
.vip-box .button-wrapper {
  align-content: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  width: 100%;
}
.vip-box .button-wrapper.button-center,
.vip-box .vip-desc {
  justify-content: center;
}
.vip-box .vip-desc {
  align-items: center;
  background-color: #f5f6fa;
  border-radius: 0.5333333333333333rem;
  display: -webkit-inline-flex;
  display: inline-flex;
  font-size: 0.37333333333333335rem;
  height: 0.9333333333333333rem;
  line-height: 0.9333333333333333rem;
  margin: 0.5333333333333333rem 0 0.5333333333333333rem 0.4rem;
  min-width: 4.4rem;
  position: relative;
}
.vip-box .vip-desc.all {
  background-color: #3077ec;
  color: #fff;
  margin: 0.5333333333333333rem 0.4rem 0.5333333333333333rem 0;
}
.vip-box .vip-desc .goods-icon {
  background-image: url(data:image/png;base64,);
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: 0.5866666666666667rem 0.6533333333333333rem;
  height: 0.6533333333333333rem;
  width: 0.5866666666666667rem;
}
.vip-box .vip-desc .goods-name {
  color: #996363;
  margin-left: 0.16rem;
  margin-right: 0.21333333333333335rem;
}
.vip-box .vip-desc .goods-txt {
  color: #98a0b3;
}
.vip-box .vip-desc .all-arrow {
  height: 0.24rem;
  position: absolute;
  right: 0.32rem;
  top: 0.3466666666666667rem;
}
.black .vip-box .vip-shadow {
  background: linear-gradient(180deg, rgba(15, 19, 24, 0), #0f1318);
}
.black .vip-box .no-shadow {
  background: transparent;
}
.black .vip-box .vip-text {
  color: #a1a3a6;
}
.black .vip-box .vip-text .more-num {
  color: #0d4280;
}
.black .vip-box .btn-box .vip-btn {
  background-color: #0d4280;
  color: #afb0b3;
}
.black .vip-box .vip-desc {
  background-color: #191e27;
}
.black .vip-box .vip-desc .goods-icon {
  background-image: url(data:image/png;base64,);
}
.black .vip-box .vip-desc .goods-name {
  color: #805a5e;
}
.black .vip-box .vip-desc .goods-txt {
  color: #616366;
}
.black .vip-box .vip-desc .arrow {
  background-image: url(data:image/png;base64,);
}
