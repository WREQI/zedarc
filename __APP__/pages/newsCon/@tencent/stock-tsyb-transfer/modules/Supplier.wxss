.component-supplier {
  background-color: var(--fill-2);
  height: 100%;
}
.component-supplier .content-wrapper {
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: space-between;
}
.component-supplier .content-wrapper .redirect-tip {
  margin-top: 6.72rem;
  text-align: center;
}
.component-supplier .content-wrapper .redirect-tip .tip-text {
  color: var(--text-color-1);
  font-size: 0.48rem;
}
.component-supplier .content-wrapper .redirect-tip .tip-sub-text {
  color: var(--text-color-5);
  font-size: 0.4rem;
  margin-top: 0.26666666666666666rem;
}
.component-supplier .content-wrapper .risk-tip {
  color: #b8becc;
  font-size: 0.26666666666666666rem;
  line-height: 0.4266666666666667rem;
  padding: 0 1.7066666666666668rem 0.72rem;
}
[data-st-theme="black"] .component-supplier .content-wrapper .risk-tip {
  color: #323a4d;
}
.component-supplier .tip-text {
  font-size: 0.37333333333333335rem;
}
