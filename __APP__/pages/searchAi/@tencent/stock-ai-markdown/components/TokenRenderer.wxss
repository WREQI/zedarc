._h1 {
  font-size: 0.8533333333333334rem;
  margin: 0.5333333333333333rem 0 0.4266666666666667rem;
}
._h1,
._h2 {
  font-weight: 700;
  line-height: 1.3;
}
._h2 {
  font-size: 0.7466666666666667rem;
  margin: 0.48rem 0 0.37333333333333335rem;
}
._h3 {
  font-size: 0.64rem;
  margin: 0.4266666666666667rem 0 0.32rem;
}
._h3,
._h4 {
  font-weight: 700;
  line-height: 1.3;
}
._h4 {
  font-size: 0.5333333333333333rem;
  margin: 0.37333333333333335rem 0 0.26666666666666666rem;
}
._h5 {
  font-size: 0.48rem;
  margin: 0.32rem 0 0.21333333333333335rem;
}
._h5,
._h6 {
  font-weight: 700;
  line-height: 1.3;
}
._h6 {
  font-size: 0.4266666666666667rem;
  margin: 0.26666666666666666rem 0 0.16rem;
}
._p {
  line-height: 1.6;
}
._ol,
._p,
._ul {
  margin: 0.32rem 0;
}
._ol,
._ul {
  padding-left: 0.5333333333333333rem;
}
._li {
  margin: 0.16rem 0;
  position: relative;
}
._blockquote {
  background-color: #f9f9f9;
  border-left: 0.10666666666666667rem solid #ddd;
  color: #666;
  margin: 0.4266666666666667rem 0;
  padding: 0.32rem 0.4266666666666667rem;
}
._code_inline {
  border-radius: 0.08rem;
  font-family: monospace;
  font-size: 0.37333333333333335rem;
  padding: 0.05333333333333334rem 0.16rem;
}
._code_inline,
._pre {
  background-color: #f5f5f5;
}
._pre {
  border-radius: 0.16rem;
  margin: 0.32rem 0;
  overflow-x: auto;
  padding: 0.32rem;
}
._code {
  font-family: monospace;
  font-size: 0.37333333333333335rem;
}
._hr {
  background-color: #ddd;
  border: none;
  height: 0.02666666666666667rem;
}
._strong {
  font-weight: 700;
}
._em {
  font-style: italic;
}
._a {
  color: #007aff;
  text-decoration: underline;
}
._img {
  border-radius: 0.10666666666666667rem;
  height: auto;
  max-width: 100%;
}
._img,
._table {
  margin: 0.32rem 0;
}
._table {
  border: 0.02666666666666667rem solid #ddd;
  border-radius: 0.10666666666666667rem;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  overflow-x: auto;
  width: 100%;
}
._thead {
  background-color: #f5f5f5;
}
._tr {
  display: -webkit-flex;
  display: flex;
}
._tr:last-child {
  border-bottom: none;
}
._th {
  align-items: center;
  background-color: #f5f5f5;
  display: -webkit-flex;
  display: flex;
  flex: 1;
  font-weight: 700;
  padding: 0.21333333333333335rem 0.32rem;
  text-align: left;
  white-space: normal !important;
}
._td,
._th {
  min-width: 1.6rem !important;
}
._th:last-child {
  border-right: none;
}
._td {
  align-items: center;
  flex: 1;
  padding: 0.21333333333333335rem 0.32rem;
  text-align: left;
}
._td:last-child {
  border-right: none;
}
._a,
._abbr,
._b,
._code,
._del,
._em,
._i,
._ins,
._label,
._q,
._span,
._strong,
._sub,
._sup {
  display: inline;
}
._text_with_newline {
  white-space: pre-wrap;
}
