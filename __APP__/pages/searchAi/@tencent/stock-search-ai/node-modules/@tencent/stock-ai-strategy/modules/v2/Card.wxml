<view class="_div component-ai-strategy-card data-v-0bae1f3d">
  <view
    bindtap="{{b}}"
    class="_div card-title flex-vcenter flex-between data-v-0bae1f3d"
  >
    <view class="_div title-text data-v-0bae1f3d">智能选股</view>
    <view class="_div sub-title-text data-v-0bae1f3d">{{a}}更新</view>
  </view>
  <view class="_div card-content data-v-0bae1f3d">
    <view bindtap="{{d}}" class="_div list-title data-v-0bae1f3d">{{c}}</view>
    <stock-list
      bind:__l="__l"
      bindclick="{{f}}"
      bindstar="{{e}}"
      class="data-v-0bae1f3d"
      uI="0bae1f3d-0"
      uP="{{g}}"
      wx:if="{{g}}"
    ></stock-list>
    <view class="_div list-entry flex-vcenter data-v-0bae1f3d">
      <view bindtap="{{i}}" class="_div flex-vcenter data-v-0bae1f3d">
        <view class="_div entry-text data-v-0bae1f3d">共{{h}}只股票</view>
        <view class="_div arrow-icon arrow-right data-v-0bae1f3d"></view>
      </view>
      <block wx:if="{{j}}">
        <view class="_div entry-split data-v-0bae1f3d"></view>
        <view bindtap="{{k}}" class="_div flex-vcenter data-v-0bae1f3d">
          <view class="_div mocktrade-icon data-v-0bae1f3d"></view>
          <view class="_div entry-text data-v-0bae1f3d">一键模拟交易</view>
          <view class="_div arrow-icon arrow-right data-v-0bae1f3d"></view>
        </view>
      </block>
    </view>
  </view>
</view>
