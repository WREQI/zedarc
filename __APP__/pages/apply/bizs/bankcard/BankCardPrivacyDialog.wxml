    <label class="data-v-91617622"
      >根据监管要求，证券开户需提供本人身份证信息进行合规验证，以保障您的账户安全。</label
    >
  </view>
  <view class="button-container flex-center data-v-91617622">
    <view
      bindtap="{{e}}"
      class="button refuse-button data-v-91617622"
      data-stat="trade.apply.idcard.privacy_dialog.refuse"
      >不同意</view
    >
    <view
      bindtap="{{f}}"
      class="button confirm-button data-v-91617622"
      data-stat="trade.apply.idcard.privacy_dialog.confirm"
      >同意并授权</view
    >
  </view>
</mp-dialog>
