<mp-dialog
  bind:__l="__l"
  class="privacy-dialog data-v-91617622"
  uI="91617622-0"
  uP="{{g}}"
  uS="{{['d']}}"
  wx:if="{{g}}"
>
  <view class="privacy-title text-color-1 flex border-bottom data-v-91617622">
    <broker-logo
      bind:__l="__l"
      class="broker-icon data-v-91617622"
      uI="91617622-1,91617622-0"
    ></broker-logo>
    <view class="data-v-91617622"
      >{{a}}申请使用您的银行卡和身份证信息用于证券开户</view
    >
  </view>
  <view class="privacy-container text-color-2 fs-28 data-v-91617622"
