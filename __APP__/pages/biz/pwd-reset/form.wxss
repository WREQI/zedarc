@import "/app.wxss";
.account-top-tip {
  color: var(--text-color-1);
  font-size: 0.426667rem;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 0.586667rem;
  padding: 0.32rem 0;
  vertical-align: middle;
}
.account-common-form {
  padding: 0 0.32rem;
}
.account-common-form .st-cell-group {
  border-radius: 0.213333rem;
  overflow: hidden;
}
.account-common-form .st-cell {
  -webkit-box-align: center;
  align-items: center;
  box-sizing: border-box;
  height: 1.386667rem;
  padding: 0.373333rem 0.24rem;
  width: 100%;
}
.account-common-form .find-account,
.account-common-form .st-cell input,
.account-common-form .st-cell--title span,
.account-common-form .st-cell--value,
.account-common-form .st-cell--value .uni-input-wrapper,
.account-common-form .st-cell--value uni-input {
  font-size: 0.4rem;
  height: 100%;
}
.account-common-form .form-input {
  color: var(--text-color-1);
}
.account-common-form .second-group {
  margin-top: 0.213333rem;
}
.account-common-form .sms-cell .st-cell--title {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.account-common-form .sms-button {
  font-size: 0.32rem;
  height: 0.746667rem;
  line-height: 0.746667rem;
  padding: 0;
  width: 2.026667rem;
}
.account-common-form .input-placeholder {
  color: var(--text-color-5);
}
.account-common-form .submit-wrapper {
  margin: 0.426667rem 0 0.533333rem;
}
.account-common-form .submit-button {
  font-size: 0.426667rem;
}
.account-common-form .protocol-container {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  font-size: 0.373333rem;
  line-height: 0.533333rem;
  margin-top: 0.426667rem;
}
.account-common-form .protocol-container .protocol-checkbox {
  transform: scale(0.7);
}
.account-common-form
  .protocol-container
  .protocol-checkbox
  .uni-checkbox-input {
  background-color: initial;
  border: 0.013333rem solid #98a0b3;
  border-radius: 50%;
  margin: unset;
}
.account-common-form
  .protocol-container
  .protocol-checkbox
  .uni-checkbox-input-checked {
  background-color: var(--color-primary-1);
  border-color: var(--color-primary-1);
  color: #fff !important;
}
.account-common-form .protocol-container .all-protocol-text {
  color: var(--color-link);
  font-weight: 500;
}
.pwd-reset-form {
  height: calc(100vh - env(safe-area-inset-bottom));
  touch-action: none;
}
.pwd-reset-form .forget-mobile-wrap {
  -webkit-box-align: center;
  -webkit-box-pack: justify;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
}
.pwd-reset-form .forget-mobile-wrap .forget-mobile,
.pwd-reset-form .forget-mobile-wrap .right-code {
  margin-top: 0.213333rem;
}
.pwd-reset-form .right-code {
  font-size: 0.373333rem;
  padding-right: 0.24rem;
}
.pwd-reset-form .title-list-account {
  color: var(--text-color-5);
  font-size: 0.373333rem;
  padding: 0.4rem 0.24rem 0.213333rem;
}
.pwd-reset-form .error-warn {
  background-color: var(--color-red);
  color: #fff;
  font-size: 0.346667rem;
  height: 0.986667rem;
  left: 0;
  line-height: 0.986667rem;
  position: absolute;
  right: 0;
  top: 0;
}
.pwd-reset-form .sms-button {
  margin-left: 0.266667rem;
}
.pwd-reset-form .fund-account {
  -webkit-box-align: center;
  align-items: center;
  color: var(--text-color-1);
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  font-size: 0.426667rem;
  font-weight: 400;
  padding: 0.24rem 0.32rem 0 0.226667rem;
}
.pwd-reset-form .broker-logo {
  height: 0.466667rem;
  margin-right: 0.106667rem;
  width: 0.466667rem;
}
