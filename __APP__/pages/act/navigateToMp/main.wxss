.container {
  background-image: url(https://st.gtimg.com/design/12ace444429de3f88a6ce598b5dc3ba3.jpeg);
  background-size: contain;
  height: 19.28rem;
  text-align: center;
  width: 100%;
}
.container .mp-logo {
  padding-top: 5.04rem;
}
.container .mp-logo .mp-logo-img {
  height: 1.6rem;
  width: 1.6rem;
}
.container .mp-title {
  color: #96a0b5;
  font-size: 0.37333333333333335rem;
  margin-top: 0.5333333333333333rem;
}
.container .mp-btn {
  background-image: linear-gradient(270deg, #e63535, #ef5350);
  border-radius: 0.5866666666666667rem;
  color: #fff;
  display: inline-block;
  font-size: 0.4266666666666667rem;
  font-weight: 500;
  height: 1.1733333333333333rem;
  line-height: 1.1733333333333333rem;
  margin-top: 0.6666666666666666rem;
  width: 6.133333333333334rem;
}
