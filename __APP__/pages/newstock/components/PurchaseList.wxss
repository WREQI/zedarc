@import "/app.wxss";
.st-divider {
  background: #98a0b3;
  background: var(--text-color-5);
}
.st-divider,
.st-divider-vertical {
  display: inline-block;
  height: 0.9em;
  margin: 0 0.106667rem;
  position: relative;
  top: -0.06em;
  vertical-align: middle;
  width: 0.013333rem;
}
.st-divider-horizontal {
  clear: both;
  display: block;
  height: 0.013333rem;
  margin: 0.32rem 0;
  width: 100%;
}
.st-divider-horizontal.st-divider-with-text,
.st-divider-horizontal.st-divider-with-text-left,
.st-divider-horizontal.st-divider-with-text-right {
  background: transparent;
  color: #98a0b3;
  color: var(--text-color-5);
  display: table;
  font-size: 0.373333rem;
  font-weight: 500;
  margin: 0.426667rem 0;
  text-align: center;
  white-space: nowrap;
}
.st-divider-horizontal.st-divider-with-text-left:after,
.st-divider-horizontal.st-divider-with-text-left:before,
.st-divider-horizontal.st-divider-with-text-right:after,
.st-divider-horizontal.st-divider-with-text-right:before,
.st-divider-horizontal.st-divider-with-text:after,
.st-divider-horizontal.st-divider-with-text:before {
  border-top: 0.013333rem solid #e5e5e5;
  content: "";
  display: table-cell;
  position: relative;
  top: 50%;
  transform: translateY(25%) scaleY(0.5);
  width: 50%;
}
.st-divider-horizontal.st-divider-with-text-left .st-divider-inner-text,
.st-divider-horizontal.st-divider-with-text-right .st-divider-inner-text {
  display: inline-block;
  padding: 0 0.266667rem;
}
.st-divider-horizontal.st-divider-with-text-left:before {
  top: 50%;
  width: 5%;
}
.st-divider-horizontal.st-divider-with-text-left:after,
.st-divider-horizontal.st-divider-with-text-right:before {
  top: 50%;
  width: 95%;
}
.st-divider-horizontal.st-divider-with-text-right:after {
  top: 50%;
  width: 5%;
}
.st-divider-inner-text {
  display: inline-block;
  padding: 0 0.64rem;
}
.purchase-list {
  background-color: var(--fill-2);
  margin-bottom: 0.786667rem;
}
.purchase-list.with-nav {
  box-sizing: border-box;
  padding-bottom: 1.333333rem;
}
.purchase-list.with-nav .bottom-bar,
.purchase-list.with-nav .submit-buy {
  margin-bottom: 49px;
  overflow: hidden;
}
.purchase-list .empty-block {
  height: 2.666667rem;
}
.purchase-list.today-hastock {
  background-color: var(--fill-1);
}
.purchase-list .submit-buy {
  background-color: var(--fill-2);
  bottom: 0.786667rem;
  box-shadow: 0-0.08rem 0.16rem 0.053333rem rgba(0, 0, 0, 0.06);
  height: 1.693333rem;
  left: 0;
  padding: 0 0.4rem env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
  z-index: 2;
}
[data-theme="dark"] .purchase-list .submit-buy {
  box-shadow: 0-0.053333rem 0.16rem 0.053333rem hsla(0, 0%, 100%, 0.06);
}
.purchase-list .submit-buy .newstock-btn {
  border-radius: 0.106667rem !important;
  height: 1.173333rem;
  line-height: 1.173333rem;
  margin: unset;
  width: 4rem;
}
.purchase-list .submit-buy .newstock-btn[disabled] {
  background-color: var(--text-color-5) !important;
  opacity: 1;
}
.purchase-list .bottom-bar {
  background-color: var(--fill-2);
  bottom: 0;
  height: 0.786667rem;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
  z-index: 2;
}
.purchase-list .bottom-bar .setting {
  padding-right: 0.213333rem;
}
.purchase-list .bottom-bar .trade-time {
  padding-left: 0.213333rem;
}
.purchase-list .no-newstock {
  box-sizing: border-box;
  padding-bottom: 0.266667rem;
}
.purchase-list .no-newstock .empty-comp {
  height: 6.133333rem !important;
}
.purchase-list .no-newstock .empty-comp .icon {
  height: 2.08rem;
  width: 1.733333rem;
}
.purchase-list .no-newstock .empty-comp .text {
  font-size: 0.4rem;
  margin-top: 0.506667rem;
}
.purchase-list .no-newstock .extended-info {
  padding: 0 0.626667rem;
}
.purchase-list .no-newstock .extended-info .divider {
  color: var(--text-color-4);
  margin-bottom: 0.506667rem;
}
.purchase-list .no-newstock .extended-info .lists-contianer {
  padding: 0 0.173333rem 0.066667rem;
}
.purchase-list .no-newstock .extended-info .lists-contianer .header {
  color: var(--text-color-4);
  font-size: 0.32rem;
  margin-bottom: 0.346667rem;
}
.purchase-list .no-newstock .extended-info .lists-contianer .lists {
  color: var(--text-color-1);
  font-size: 0.4rem;
}
.purchase-list .no-newstock .extended-info .lists-contianer .lists .stock-name {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
}
.purchase-list .no-newstock .extended-info .lists-contianer .lists .stock-code {
  color: var(--text-color-4);
  font-size: 0.293333rem;
  margin-top: 0.133333rem;
}
.purchase-list
  .no-newstock
  .extended-info
  .lists-contianer
  .lists
  > .flex-between {
  margin-bottom: 0.32rem;
}
.purchase-list .no-newstock .extended-info.border-bottom-1:after {
  border-color: var(--border-color-1);
}
.purchase-list .no-newstock .code {
  display: inline-block;
}
.purchase-list .no-newstock .icon-kcb {
  background-color: var(--color-primary-1);
  border-radius: 0.053333rem;
  color: #fff;
  display: inline-block;
  font-size: 0.213333rem;
  height: 0.266667rem;
  line-height: 0.293333rem;
  margin-left: 0.133333rem;
  position: relative;
  text-align: center;
  top: -0.026667rem;
  width: 0.266667rem;
}
.purchase-list .newstock-buy-dialog-container {
  color: var(--text-color-1);
}
.purchase-list .newstock-buy-dialog-container .title {
  font-size: 0.48rem;
  margin-bottom: 0.48rem;
  text-align: center;
}
.purchase-list .newstock-buy-dialog-container .item {
  margin-bottom: 0.4rem;
}
.purchase-list .newstock-buy-dialog-container .item:last-child {
  margin-bottom: 0;
}
.purchase-list .newstock-buy-dialog-container .item span:nth-of-type(2) {
  font-weight: 500;
}
.purchase-list .input-li-content {
  -webkit-box-pack: start;
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  height: 1.333333rem;
  justify-content: flex-start;
}
.purchase-list .input-li-content radio {
  transform: scale(1);
}
.purchase-list .left-checkbox {
  padding-left: 0.506667rem;
  width: 100%;
}
.purchase-list .left-checkbox .uni-radio-wrapper,
.purchase-list .left-checkbox .wrapper {
  width: 100%;
}
.purchase-list .left-title {
  -webkit-box-flex: 1;
  color: var(--text-color-1);
  flex: 1;
  font-size: 0.426667rem;
  height: 1.333333rem;
  line-height: 1.333333rem;
  padding-left: 0.266667rem;
  text-align: left;
}
.purchase-list .right-text {
  line-height: 1.333333rem;
}
.purchase-list .right-input,
.purchase-list .right-text {
  color: var(--text-color-4);
  font-size: 0.426667rem;
  height: 1.333333rem;
  padding-right: 0.493333rem;
  text-align: right;
}
.purchase-list .right-input {
  margin-top: 0.08rem;
  width: 56%;
}
.purchase-list .input-placeholder {
  color: var(--text-color-4);
  font-size: 0.426667rem;
  text-align: right;
}
.purchase-list .icon-wrapper {
  height: 0.453333rem;
  line-height: 0.453333rem;
  margin-right: 0.106667rem;
  width: 0.453333rem;
}
.purchase-list .icon-wrapper .custom-radio {
  border-radius: 50%;
  color: var(--text-color-5);
  font-size: 0.426667rem;
}
.purchase-list .icon-wrapper .custom-radio-disabled {
  background-color: var(--fill-1);
}
[data-theme="dark"] .purchase-list .icon-wrapper .custom-radio-disabled {
  background-color: var(--fill-3);
}
.purchase-list .icon-wrapper .icon-checked {
  color: var(--color-primary);
  font-size: 0.453333rem;
}
.purchase-list .risk-tip {
  color: var(--text-color-4);
  font-size: 0.293333rem;
  line-height: 1.3;
  margin: 0.4rem;
  text-align: left;
  white-space: pre-line;
}
.purchase-list .risk-tip .header {
  font-weight: 700;
  margin-bottom: 0.16rem;
}
.purchase-list .risk-tip.popup {
  margin: 0.4rem 0 0;
  position: relative;
}
.purchase-list .risk-tip.popup .text {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  width: calc(100% - 0.533333rem);
}
.purchase-list .risk-tip.popup .text .em {
  width: 0.533333rem;
}
.purchase-list .risk-tip.popup .expand-btn {
  bottom: 0;
  color: var(--color-primary-1);
  position: absolute;
  right: 0;
  text-align: center;
}
.purchase-list .risk-tip.popup .text.expand {
  -webkit-line-clamp: unset;
  width: 100%;
}
.purchase-list .risk-tip.popup .text.expand ~ .expand-btn {
  transform: translateY(100%);
}
.purchase-list .risk-tip.no-newstock {
  box-sizing: border-box;
  margin: 0 0 0.4rem;
  padding: 0.2rem 0 0.4rem;
}
