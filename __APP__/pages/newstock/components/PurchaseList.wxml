                <view class="header flex-between">
                    <view class="flex-1 align-l">股票名称</view>
                    <view class="flex-1 align-c">发行价</view>
                    <view class="flex-1 align-r">申购时间</view>
                </view>
                <view class="lists">
                    <view bindtap="{{item.h}}" class="flex-between" wx:for="{{F}}" wx:key="g">
