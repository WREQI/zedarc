                        <view class="right-text">{{ah}}</view>
                    </view>
                </radio>
            </view>
            <view class="input-li-content border-bottom-1">
                <radio checked="{{ap}}" class="left-checkbox" color="var(--color-primary)" value="1">
                    <view class="wrapper flex-between">
                        <view class="left-title">自定义申购</view>
                        <input alwaysEmbed="{{true}}" bindblur="{{al}}" bindfocus="{{am}}" bindinput="{{ao}}" class="right-input" focus="{{aj}}" id="debtNumInput" maxlength="{{5}}" pattern="d*" placeholder="{{ak}}" placeholderClass="input-placeholder" type="tel" value="{{an}}"></input>
                    </view>
                </radio>
            </view>
        </radio-group>
    </action-sheet>
    <mp-dialog bind:__l="__l" bindconfirm="{{av}}" uI="50878bb2-10" uP="{{aw}}" wx:if="{{aw}}"></mp-dialog>
    <register-risk-popup bind:__l="__l" uI="50878bb2-11" uP="{{ax}}" wx:if="{{ax}}"></register-risk-popup>
    <protocol-dialog bind:__l="__l" bindcancel="{{az}}" bindconfirm="{{ay}}" uI="50878bb2-12" uP="{{aA}}" wx:if="{{aA}}"></protocol-dialog>
</view>
