            <view class="title">申购{{W}}</view>
            <view class="flex-between item" wx:for="{{X}}" wx:key="d">
                <label>{{item.a}}</label>
                <label>{{item.b}} {{item.c}}</label>
            </view>
            <view class="risk-tip popup" wx:if="{{Y}}">
                <view class="header">{{Z}}</view>
                <view class="{{['text',ab&&'expand']}}">{{aa}}<label class="em"></label>
                </view>
                <label bindtap="{{ad}}" class="expand-btn">{{ac}}</label>
            </view>
        </view>
    </mp-dialog>
    <action-sheet bind:__l="__l" bindconfirm="{{as}}" bindinput="{{ar}}" class="amount-action-sheet" uI="50878bb2-9" uP="{{at}}" uS="{{['d']}}" wx:if="{{at}}">
        <radio-group bindchange="{{aq}}">
            <view class="input-li-content border--bottom">
                <radio checked="{{ai}}" class="left-checkbox" color="var(--color-primary)" value="0">
