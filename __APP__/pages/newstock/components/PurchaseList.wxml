        <purchase-list-item bind:__l="__l" bindonPicker="{{g}}" bindselect="{{h}}" uI="50878bb2-1" uP="{{i}}" wx:if="{{f}}"></purchase-list-item>
        <purchase-list-item bind:__l="__l" bindonPicker="{{k}}" bindselect="{{l}}" uI="50878bb2-2" uP="{{m}}" wx:if="{{j}}"></purchase-list-item>
        <purchase-list-item bind:__l="__l" bindonPicker="{{o}}" bindselect="{{p}}" uI="50878bb2-3" uP="{{q}}" wx:if="{{n}}"></purchase-list-item>
        <purchase-list-item bind:__l="__l" bindonPicker="{{s}}" bindselect="{{t}}" uI="50878bb2-4" uP="{{v}}" wx:if="{{r}}"></purchase-list-item>
