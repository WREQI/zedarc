                            <view class="stock-code">
                                <label class="code">{{item.b}}{{item.c}}</label>
                                <label class="icon-kcb" wx:if="{{item.d}}">科</label>
                            </view>
                        </view>
                        <view class="flex-1 align-c">{{item.e}}</view>
                        <view class="flex-1 align-r">{{item.f}}</view>
                    </view>
                </view>
            </view>
            <view class="risk-tip no-newstock border-top" wx:if="{{G}}">
                <view class="header">风险提示</view>{{H}}</view>
        </view>
    </view>
    <view class="submit-buy flex-between" wx:if="{{I}}">
        <view bindtap="{{M}}" class="select-all flex-vcenter">
            <view class="icon-wrapper">
                <label class="{{['icon','icon-check-box','custom-radio',J&&'icon-checked',K&&'custom-radio-disabled']}}"></label>
            </view>
            <view class="{{['fs-34',L]}}">全选</view>
        </view>
        <view bindtap="{{Q}}" class="select-only-stock flex-vcenter">
            <view class="icon-wrapper">
                <label class="{{['icon','icon-check-box','custom-radio',N&&'icon-checked',O&&'custom-radio-disabled']}}"></label>
            </view>
            <view class="{{['fs-34',P]}}">仅新股</view>
        </view>
        <button bindtap="{{T}}" class="newstock-btn" disabled="{{S}}" type="primary">一键申购{{R}}</button>
    </view>
    <view class="bottom-bar flex-center">
        <view bindtap="{{V}}" class="setting fs-24 primary-color border-right" data-stat="trade.playnew.setting" wx:if="{{U}}">提醒设置</view>
        <view class="trade-time text-color-4 fs-24">申购时间：交易日9:30~15:00</view>
    </view>
    <mp-dialog bind:__l="__l" bindcancel="{{af}}" bindconfirm="{{ae}}" uI="50878bb2-8" uP="{{ag}}" uS="{{['d']}}" wx:if="{{ag}}">
