<view class="_div guess-card data-v-2cac6b18">
  <view class="_div guess-card__body data-v-2cac6b18">
    <view
      bindtap="{{d}}"
      class="_div guess-card__title data-v-2cac6b18"
      wx:if="{{a}}"
    >
      <block wx:if="{{b}}"
        >{{c}}<view class="_div guess-card__title-label data-v-2cac6b18"
          >上证指数</view
        >
      </block>
      <view class="_div guess-card__title-placeholder data-v-2cac6b18" wx:else
        >加载中...</view
      >
    </view>
    <view
      class="_div guess-card__chart data-v-2cac6b18"
      ref="kLine"
      wx:if="{{e}}"
    >
      <view class="_div guess-card__chart-box data-v-2cac6b18">
        <view
          class="_div guess-card__chart-canvas data-v-2cac6b18"
          hidden="{{!i}}"
        >
          <view
            class="_div guess-card__chart-placeholder data-v-2cac6b18"
            wx:if="{{f}}"
          >
            <view class="_div guess-card__chart-loading data-v-2cac6b18"
              >K线加载中...</view
            >
          </view>
          <view
            class="_div guess-card__chart-wrapper data-v-2cac6b18"
            wx:if="{{g}}"
          >
            <mins
              bind:__l="__l"
              class="data-v-2cac6b18"
              uI="2cac6b18-0"
              uP="{{h}}"
              wx:if="{{h}}"
            ></mins>
          </view>
        </view>
        <view
          class="_div guess-card__chart-empty data-v-2cac6b18"
          wx:if="{{j}}"
        >
          <view class="_div guess-card__chart-tip data-v-2cac6b18"
            >{{k}}尚未开盘</view
          >
          <image
            alt="尚未开盘"
            class="_img guess-card__chart-img data-v-2cac6b18"
            src="{{l}}"
          ></image>
        </view>
        <view class="_div guess-card__chart-overlay data-v-2cac6b18">
          <view
            class="_div guess-card__chart-mask data-v-2cac6b18"
            wx:if="{{m}}"
          >
            <label class="_span data-v-2cac6b18">{{n}}上证指数已结束</label>
          </view>
        </view>
      </view>
    </view>
    <view class="_div guess-card__subscribe data-v-2cac6b18" wx:if="{{o}}">
      <image
        showMenuByLongpress
        alt="关注二维码"
        class="_img guess-card__subscribe-img data-v-2cac6b18"
        src="{{p}}"
      ></image>
    </view>
    <view class="_div guess-card__operation data-v-2cac6b18" ref="operation">
      <operation
        bind:__l="__l"
        bindguessOpResult="{{q}}"
        class="data-v-2cac6b18"
        uI="2cac6b18-1"
        uP="{{r}}"
        wx:if="{{r}}"
      ></operation>
    </view>
  </view>
</view>
