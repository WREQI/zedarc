.portrait-apply-guide-card-container {
  background: var(--fill-content-layer, #fff);
  min-height: 3.466666666666667rem;
  position: relative;
  width: 100%;
}
.portrait-apply-guide-card-container .gray-line {
  background: #f5f6fa;
  height: 0.16rem;
  opacity: 1;
  width: 100%;
}
.portrait-apply-guide-card-container .text {
  padding-bottom: 0.5333333333333333rem;
  padding-left: 0.4rem;
  padding-top: 0.5333333333333333rem;
}
.portrait-apply-guide-card-container .text .main_title {
  color: #354875;
  font-size: 0.4266666666666667rem;
  font-weight: 600;
  line-height: 0.5866666666666667rem;
  margin-bottom: 0.16rem;
}
.portrait-apply-guide-card-container .text .sub_title {
  color: var(--color-midgray, #475166);
  font-family: PingFang SC;
  font-size: 0.37333333333333335rem;
  font-weight: 400;
  line-height: 0.5333333333333333rem;
  opacity: 1;
}
.portrait-apply-guide-card-container .text .sub_title .highlight {
  color: #e63535;
}
.portrait-apply-guide-card-container .text .sub_title2 {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  height: 0.5333333333333333rem;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.portrait-apply-guide-card-container .text .sub_title2 .sub_item {
  color: var(--color-midgray, #475166);
  font-family: PingFang SC;
  font-size: 0.37333333333333335rem;
  font-weight: 400;
  left: 0;
  line-height: 0.5333333333333333rem;
  opacity: 1;
  position: absolute;
  top: 0;
}
.portrait-apply-guide-card-container .text .sub_title2 .sub_item .highlight {
  color: #e63535;
}
.portrait-apply-guide-card-container .text .sub_title2 .animate {
  animation-duration: 3s;
  animation-iteration-count: infinite;
  animation-name: carousel;
  animation-timing-function: ease;
}
.portrait-apply-guide-card-container .text .btn {
  align-items: center;
  background: #3077ec;
  border-radius: 0.10666666666666667rem;
  color: #fff;
  display: -webkit-flex;
  display: flex;
  font-family: PingFang SC;
  font-size: 0.37333333333333335rem;
  font-weight: 600;
  height: 0.8533333333333334rem;
  justify-content: center;
  line-height: 0.5333333333333333rem;
  margin-top: 0.26666666666666666rem;
  opacity: 1;
  width: 2.1333333333333333rem;
}
.portrait-apply-guide-card-container .bg {
  background-repeat: no-repeat;
  background-size: 100% 100%;
  height: 2.56rem;
  position: absolute;
  right: 0;
  top: 0.72rem;
  width: 4.986666666666666rem;
}
@-webkit-keyframes carousel {
  0% {
    top: 33px;
  }
  8% {
    top: 0;
  }
  50% {
    top: 0;
  }
  92% {
    top: 0;
  }
  to {
    top: -35px;
  }
}
@keyframes carousel {
  0% {
    top: 33px;
  }
  8% {
    top: 0;
  }
  50% {
    top: 0;
  }
  92% {
    top: 0;
  }
  to {
    top: -35px;
  }
}
