@import "/app.wxss";
.transfer-form-container {
  background-color: var(--fill-2);
  padding: 0.64rem 0.4rem 0.453333rem;
}
.transfer-form-container .section-tips {
  margin-bottom: 0.746667rem;
}
.transfer-form-container .section-tips .money-unit {
  font-size: 0.266667rem;
  margin: 0.32rem 0 0 0.96rem;
  position: absolute;
}
.transfer-form-container .section-tips .money-unit.pl {
  padding-left: 0.106667rem;
}
.transfer-form-container .fund-input-wrapper {
  position: relative;
}
.transfer-form-container .rmb {
  font-size: 0.96rem;
}
.transfer-form-container .fund-input {
  font-size: 0.8rem;
  height: 0.8rem;
  line-height: 0.8rem;
  margin-top: 0.133333rem;
}
.transfer-form-container .fund-input-focus-android {
  position: relative;
}
.transfer-form-container .input-placeholder {
  font-size: 0.426667rem;
  line-height: inherit !important;
}
.transfer-form-container .error-layout {
  padding: 0.4rem 0;
}
.transfer-form-container .error-layout .error-icon {
  height: 1.6rem;
  margin: 0 auto;
  position: relative;
  width: 1.6rem;
}
.transfer-form-container .error-layout .error-icon .icon-wrapper {
  border: 0.04rem solid;
  border-color: var(--color-red);
  border-radius: 50%;
  box-sizing: border-box;
  color: var(--color-red);
  height: 100%;
  width: 100%;
}
.transfer-form-container .error-layout .error-icon .icon-wrapper .icon {
  font-size: 0.733333rem;
}
.transfer-form-container .error-layout .error-title {
  color: var(--text-color-1);
  font-size: 0.4rem;
  font-weight: 600;
  margin-top: 0.48rem;
}
.transfer-form-container .error-layout .error-tips {
  color: var(--text-color-4);
  font-size: 0.346667rem;
  line-height: 1.3;
  margin-top: 0.533333rem;
}
