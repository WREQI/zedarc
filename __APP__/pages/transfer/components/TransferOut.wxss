@import "/app.wxss";
.transfer-out .icon-info {
  margin-left: 0.266667rem;
}
.transfer-out .over-max {
  line-height: 0.293333rem;
  margin: 0.293333rem 0.4rem 0;
}
.transfer-out .button-wrapper,
.transfer-out .tips {
  padding: 0.426667rem 0.4rem 0;
}
.transfer-out .tips {
  color: var(--text-color-5);
  font-size: 0.373333rem;
  line-height: 0.533333rem;
  text-align: center;
}
.transfer-out .action {
  font-size: 0.373333rem;
  position: relative;
  text-align: right;
  top: 0.4rem;
  width: 2.933333rem;
}
.transfer-out .transfer-plan-dialog {
  padding: 0.426667rem 0.64rem 0.533333rem;
}
.transfer-out .transfer-plan-dialog .title {
  line-height: 1.4;
}
.transfer-out .transfer-plan-dialog .table {
  margin-bottom: 0.213333rem;
  margin-top: 0.293333rem;
  position: relative;
  width: 100%;
}
.transfer-out .transfer-plan-dialog .col {
  -webkit-box-flex: 1;
  flex: 1;
  font-weight: 400;
  padding: 0.24rem 0 0.213333rem 0.253333rem;
}
.transfer-out .transfer-plan-dialog .col:nth-of-type(1) {
  -webkit-box-flex: 0;
  flex: 0 0 40%;
}
.transfer-out .transfer-plan-dialog .col:nth-of-type(2) {
  -webkit-box-flex: 0;
  flex: 0 0 30%;
}
.transfer-out .transfer-plan-dialog .row {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.transfer-out .transfer-plan-dialog .merge {
  position: absolute;
  right: 2%;
  top: 50%;
}
.transfer-out .transfer-amount {
  font-size: 0.426667rem;
  line-height: 0.586667rem;
}
.transfer-out .delay-tip-container {
  margin-top: 0.106667rem;
}
.transfer-out .delay-tip {
  color: var(--text-color-5);
  font-size: 0.32rem;
  line-height: 0.453333rem;
}
.transfer-out .debt-auto-order-text {
  color: var(--color-link);
  font-size: 0.4rem;
  font-weight: 700;
}
.transfer-out .transfer-animate {
  background-color: var(--fill-2);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 100;
}
