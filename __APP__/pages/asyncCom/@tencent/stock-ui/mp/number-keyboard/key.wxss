.st-key {
  align-items: center;
  background-color: var(--fill-2);
  border-radius: 0.10666666666666667rem;
  color: var(--text-color-1);
  cursor: pointer;
  display: -webkit-flex;
  display: flex;
  font-size: 0.64rem;
  height: 1.2rem;
  justify-content: center;
  line-height: 1.5;
  outline: none;
}
.st-key--large {
  bottom: 0.26666666666666666rem;
  flex: 2;
  height: auto;
  left: 0;
  position: absolute;
  right: 0.26666666666666666rem;
  top: 0;
}
.st-key.st-key--red {
  background-color: var(--color-red);
}
.st-key.st-key--red:active {
  background-color: #c43031;
}
.st-key.st-key--green {
  background-color: var(--color-green);
}
.st-key.st-key--green:active {
  background-color: #1a8a34;
}
.st-key--blue,
.st-key--delete,
.st-key--green,
.st-key--red {
  font-size: 0.4266666666666667rem;
}
.st-key:active {
  background-color: #e9ebf0;
}
[data-theme="dark"] .st-key:active {
  background: #191e27;
}
.st-key--blue {
  background-color: var(--color-primary);
  color: #fff;
  font-weight: 500;
}
.st-key--blue:active {
  background-color: var(--color-primary-active);
}
.st-key__collapse-icon,
.st-key__delete-icon {
  font-size: 0.48rem;
}
.st-key .icon-delet {
  background: url(data:image/svg+xml;base64,)
    no-repeat 50%;
  background-size: auto 0.4rem;
  height: 100%;
  width: 100%;
}
.st-key .icon-keyborad {
  background: url(data:image/svg+xml;base64,)
    no-repeat 50%;
  background-size: auto 0.4rem;
  height: 100%;
  width: 100%;
}
