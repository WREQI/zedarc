.st-number-keyboard {
  animation-timing-function: ease;
  background-color: var(--fill-2);
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  user-select: none;
  width: 100%;
  z-index: 100;
}
.st-number-keyboard__title {
  background-color: var(--fill-2);
  border-top: 0.013333333333333334rem solid var(--border-color-1);
  color: var(--text-color-1);
  font-size: 0.4266666666666667rem;
  height: 0.8rem;
  line-height: 0.8rem;
  position: relative;
  text-align: center;
}
.st-number-keyboard__title .st-number-keyboard__close {
  color: var(--text-color-4);
  font-size: 0.37333333333333335rem;
  left: 0;
  line-height: 0.8rem;
  padding: 0 0.4rem;
  position: absolute;
}
.st-number-keyboard__body {
  box-sizing: border-box;
}
.st-number-keyboard__keys {
  display: -webkit-flex;
  display: flex;
  flex: 3;
  flex-wrap: wrap;
}
.st-number-keyboard__sidebar {
  display: -webkit-flex;
  display: flex;
  flex: 1;
  flex-direction: column;
}
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(1),
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(2) {
  flex: 1;
  flex-basis: 25%;
}
.st-number-keyboard__sidebar .st-key__wrapper:nth-of-type(3) {
  flex: 2;
  flex-basis: 50%;
}
.st-number-keyboard__sidebar .st-key__wrapper.flex {
  gap: 0.26666666666666666rem;
}
.st-number-keyboard__done {
  color: var(--color-blue);
  font-size: 0.37333333333333335rem;
  padding: 0 0.4266666666666667rem;
  position: absolute;
  right: 0;
}
.st-number-keyboard__custom {
  background-color: var(--fill-1);
}
.st-number-keyboard__custom .st-number-keyboard__body {
  display: -webkit-flex;
  display: flex;
  padding: 0.32rem 0.05333333333333334rem 0.05333333333333334rem 0.32rem;
}
.st-number-keyboard__custom .st-key__wrapper {
  padding: 0 0.26666666666666666rem 0.26666666666666666rem 0;
}
.st-number-keyboard--embedded {
  padding-bottom: 0;
}
.st-number-key {
  background-color: var(--fill-2);
  border-right: 0.013333333333333334rem solid var(--border-color-1);
  border-top: 0.013333333333333334rem solid var(--border-color-1);
  box-sizing: border-box;
  color: var(--text-color-1);
  display: inline-block;
  font-size: 0.64rem;
  font-style: normal;
  height: 1.44rem;
  line-height: 1.44rem;
  text-align: center;
  vertical-align: middle;
  width: calc(100% / 3);
}
.st-number-key:nth-of-type(3n) {
  border-right: none;
}
.st-number-key--delete {
  background: url(data:image/png;base64,)
    no-repeat 50%;
  background-size: auto 0.4rem;
  font-size: 0 !important;
}
.st-number-key--gray,
.st-number-key:active {
  background-color: var(--border-color-1);
}
.st-key__wrapper {
  box-sizing: border-box;
  flex: 1;
  flex-basis: 33%;
  padding: 0 0.16rem 0.16rem 0;
  position: relative;
}
