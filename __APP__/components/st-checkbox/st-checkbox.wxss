@import "/app.wxss";
.st-checkbox {
  height: 0.56rem;
  position: relative;
  vertical-align: middle;
  width: 0.56rem;
}
.st-checkbox,
.st-checkbox-wrapper {
  display: inline-block;
}
.st-checkbox-inner {
  border: 1px solid #e5e5e5;
  border-radius: 50%;
  box-sizing: border-box;
  color: transparent;
  font-size: 0.56rem;
  height: 0.56rem;
  line-height: 0.56rem;
  position: absolute;
  right: 0;
  text-align: center;
  width: 0.56rem;
}
.st-checkbox-inner:before {
  position: relative;
}
.st-checkbox-input {
  appearance: none;
  border: 0;
  height: 100%;
  left: 0;
  margin: 0;
  opacity: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 2;
}
.st-checkbox.st-checkbox-checked .st-checkbox-inner {
  background: var(--color-primary-1);
  border: 0;
  color: #fff;
}
.st-checkbox.st-checkbox-square .st-checkbox-inner {
  border-radius: 0;
}
.st-checkbox.st-checkbox-hollow .st-checkbox-inner {
  background: var(--fill-2);
  border-color: #e5e5e5;
  color: var(--fill-2);
}
.st-checkbox.st-checkbox-hollow.st-checkbox-checked .st-checkbox-inner {
  color: var(--color-primary-1);
}
.st-checkbox-small {
  height: 0.4rem;
  width: 0.4rem;
}
.st-checkbox-small .st-checkbox-inner {
  font-size: 0.213333rem;
  height: 0.4rem;
  line-height: 0.4rem;
  width: 0.4rem;
}
.st-checkbox-small .st-checkbox-inner:before {
  font-size: 0.186667rem;
}
