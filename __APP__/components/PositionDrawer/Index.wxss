@import "/app.wxss";
.position-drawer {
  background-color: var(--fill-2);
  box-sizing: border-box;
  margin-top: 0.293333rem;
  padding-left: 0.32rem;
  white-space: nowrap;
  width: 100vw;
}
[data-simple="true"] .position-drawer {
  width: calc(100vw - 0.64rem);
}
.position-drawer.hide-fund {
  margin-top: 0.773333rem;
}
[data-simple="true"] .position-drawer.hide-fund {
  margin-top: 0.8rem;
}
.position-drawer .wrapper {
  overflow-x: auto;
  padding: 0.266667rem 0;
  width: 100%;
}
.position-drawer .wrapper::-webkit-scrollbar {
  display: none;
}
.position-drawer.hide-margin-top {
  margin-top: 0;
}
.position-drawer .drawer-item {
  display: inline-block;
  text-align: center;
  width: 0.96rem;
}
.position-drawer .drawer-item.drawer-wrapper-5 {
  margin-right: 1.1rem;
}
.position-drawer .drawer-item.drawer-wrapper-4 {
  margin-right: 1.786667rem;
}
.position-drawer .drawer-item.drawer-wrapper-3 {
  margin-right: 3.16rem;
}
.position-drawer .drawer-item.drawer-wrapper-2 {
  margin-right: 1.1rem;
}
.position-drawer .drawer-item:last-child {
  margin-right: unset;
}
.position-drawer .drawer-item.drawer-item--currency-last {
  margin-left: -0.213333rem;
  width: 1.173333rem !important;
}
.position-drawer .drawer-item.pr-60 {
  padding-right: 0.8rem;
}
[data-simple="true"] .position-drawer .drawer-item {
  width: unset;
}
[data-simple="true"] .position-drawer .drawer-item.drawer-wrapper-5 {
  margin-right: 1.266667rem;
}
[data-simple="true"] .position-drawer .drawer-item.drawer-wrapper-4 {
  margin-right: 1.906667rem;
}
[data-simple="true"] .position-drawer .drawer-item.drawer-wrapper-3 {
  margin-right: 3.24rem;
}
[data-simple="true"] .position-drawer .drawer-item.drawer-wrapper-2 {
  margin-right: 1.893333rem;
}
[data-simple="true"] .position-drawer .drawer-item:last-child {
  margin-right: unset;
}
.position-drawer .drawer-item .text {
  color: var(--text-color-2);
  font-size: 0.32rem;
  line-height: 0.453333rem;
  margin-top: 0.066667rem;
  text-align: center;
  white-space: nowrap;
}
.position-drawer .icon {
  background-repeat: no-repeat;
  background-size: 100%;
  height: 0.533333rem;
  margin: 0 auto;
  width: 0.533333rem;
}
.position-drawer .icon:before {
  content: "";
}
.position-drawer .icon.icon-hq {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/position-drawer/light/hq.png);
}
[data-theme="dark"] .position-drawer .icon.icon-hq {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/position-drawer/dark/hq.png);
}
.position-drawer .icon.icon-quote {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/position-drawer/light/quote.png);
