@import "/app.wxss";
.password-component--bank,
.password-component--bank-wrap .mp-popup {
  border-top-left-radius: 0.213333rem;
  border-top-right-radius: 0.213333rem;
}
.password-component--bank {
  background-color: var(--fill-2);
  color: var(--text-color-1);
  height: 11.893333rem;
  transform: translateZ(0);
  transition: all 0.3s ease-out;
}
.password-component--bank.password-iniframe {
  transform: translateZ(0);
  transition: all 0s ease-out;
}
.password-component--bank .title-wrap {
  -webkit-box-pack: justify;
  justify-content: space-between;
  padding: 0.426667rem 0.4rem 0.64rem;
}
.password-component--bank .title-wrap,
.password-component--bank .title-wrap .title-wrap-center {
  -webkit-box-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.password-component--bank .title-wrap .title-wrap-center {
  padding-left: 0.48rem;
}
.password-component--bank .title-wrap .title-wrap-center .bank-logo {
  height: 0.533333rem;
  padding-right: 0.213333rem;
  width: 0.533333rem;
}
.password-component--bank
  .title-wrap
  .title-wrap-center
  .bank-logo
  .server-bank-logo {
  height: 0.533333rem;
  position: absolute;
  width: 0.533333rem;
}
.password-component--bank
  .title-wrap
  .title-wrap-center
  .bank-logo
  .server-bank-logo
  .bank-logo-icon {
  position: absolute;
}
.password-component--bank .title-wrap .title-wrap-center .bank-name {
  font-size: 0.426667rem;
  font-weight: 400;
  line-height: 0.613333rem;
}
.password-component--bank .title-wrap .close-bg {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/half-close.png);
  background-repeat: no-repeat;
  background-size: cover;
  height: 0.48rem;
  width: 0.48rem;
}
.password-component--bank .content-wrap {
  font-size: 0.48rem;
  font-weight: 600;
  line-height: 0.666667rem;
  padding-bottom: 0.64rem;
  text-align: center;
}
.password-component--bank .st-password-input {
  padding: 0 1.106667rem;
}
.password-component--bank .st-password-input .st-password-input__security {
  border: none;
  height: 1.12rem;
}
.password-component--bank .st-password-input .st-password-inpu__item {
  background-color: var(--fill-1);
  border: none;
  border-radius: 0.106667rem;
  height: 1.12rem;
  margin-right: 0.213333rem;
  width: 1.12rem;
}
.password-component--bank
  .st-password-input
  .st-password-inpu__item:last-child {
  margin-right: 0;
}
.password-component--bank .st-number-key--gray {
  background-color: var(--fill-1);
}
.password-component--bank .st-number-key {
  border-right: 1px solid var(--fill-1);
  border-top: 1px solid var(--fill-1);
  font-size: 0.666667rem;
}
.password-component--bank .st-number-keyboard {
  padding-bottom: 0;
}
.password-simple .call-broker {
  border-color: var(--color-red);
  color: var(--color-red);
}
.password-simple .reset-pwd {
  background-color: var(--color-red);
}
