.pre-captcha {
  align-items: center;
  background: #fff;
  display: -webkit-flex;
  display: flex;
  height: 220rpx;
  justify-content: center;
  width: 220rpx;
}
.dots-item {
  background: #1a79ff;
  border-radius: 50%;
  height: 20rpx;
  margin: 0 6rpx;
  width: 20rpx;
}
.captcha {
  background: #fff;
  border-radius: 10rpx;
  box-sizing: border-box;
  display: inline-block;
  padding: 20rpx;
  position: relative;
  width: 660rpx;
}
.captcha-header {
  color: #999;
  font-size: 26rpx;
  height: 30rpx;
}
.captcha-title-warp {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  height: 80rpx;
}
.captcha-title {
  font-size: 36rpx;
}
.btn-close {
  height: 44rpx;
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 44rpx;
}
.captcha-body {
  overflow: hidden;
  position: relative;
}
.bg-area {
  height: auto;
  width: 100%;
}
.placeholder-img {
  display: block;
  visibility: hidden;
  width: 100%;
}
.bg-img {
  left: 0;
  opacity: 1;
  position: absolute;
  top: 0;
  transition: opacity 0.3s;
  width: 100%;
}
.captcha-fg-item {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: center;
  position: absolute;
}
.captcha-fg-item__img {
  height: 28rpx;
  width: 40rpx;
}
.captcha-fg-item .captcha-fg-item__img {
  display: none;
}
.captcha-fg-item.slider {
  border-radius: 999rpx;
}
.captcha-fg-item.slider .captcha-fg-item__img {
  display: block;
}
.captcha-click-mark {
  align-items: center;
  border: 4rpx solid #fff;
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  height: 40rpx;
  justify-content: center;
  position: absolute;
  transform: translate(-50%, -50%);
  width: 40rpx;
}
.captcha-click-number {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.captcha-footer {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}
.error-text {
  color: #ec1313;
  font-size: 30rpx;
}
.captcha-footer__right {
  align-items: center;
  display: -webkit-flex;
  display: flex;
}
.btn-refresh {
  height: 40rpx;
  margin-right: 10rpx;
  width: 40rpx;
}
.btn-verify {
  align-items: center;
  border-radius: 8rpx;
  color: #fff;
  font-size: 28rpx;
  height: 58rpx;
  justify-content: center;
  margin-left: 12rpx;
  margin-right: 0;
  width: 120rpx;
}
.btn-verify,
.cover {
  display: -webkit-flex;
  display: flex;
}
.cover {
  background: hsla(0, 0%, 100%, 0.8);
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 4;
}
.tip-cover {
  align-items: center;
  flex-direction: column;
  justify-content: center;
}
.load-error-cover {
  background: #efefef;
}
.load-error-text {
  color: #999;
  font-size: 30rpx;
}
.load-error-icon {
  height: 54rpx;
  margin-top: 18rpx;
  width: 76rpx;
}
.verify-error-icon {
  height: 54rpx;
  width: 70rpx;
}
.verify-error-text {
  color: #1c85ff;
  font-size: 34rpx;
  margin: 30rpx 18rpx;
}
.verify-error-sid {
  color: #1c85ff;
}
.cover-success-img {
  height: 120rpx;
  width: 220rpx;
}
.cover-success-text {
  color: #1bc300;
  font-size: 34rpx;
  margin-top: 28rpx;
}
.loading-dots {
  margin: 0 auto;
  position: relative;
  top: 47%;
  transform: translateY(-50%);
  width: 128rpx;
  z-index: 4;
}
.loading-dot {
  background: #b3b3b3;
  border-radius: 50%;
  height: 20rpx;
  position: absolute;
  top: 50%;
  width: 20rpx;
}
.dot0 {
  animation: dot0 0.8s linear infinite;
  left: 20rpx;
  transform: scale(0.4, 0.4);
}
.dot1 {
  animation: dot1 0.8s linear infinite;
  left: 27rpx;
}
.dot2 {
  animation: dot2 0.8s linear infinite;
  left: 54rpx;
}
.dot3 {
  animation: dot3 0.8s linear infinite;
  left: 77rpx;
}
@-webkit-keyframes dot0 {
  to {
    left: 28rpx;
    transform: scale(1, 1);
  }
}
@keyframes dot0 {
  to {
    left: 28rpx;
    transform: scale(1, 1);
  }
}
@-webkit-keyframes dot1 {
  to {
    left: 53rpx;
  }
}
@keyframes dot1 {
  to {
    left: 53rpx;
  }
}
@-webkit-keyframes dot2 {
  to {
    left: 78rpx;
  }
}
@keyframes dot2 {
  to {
    left: 78rpx;
  }
}
@-webkit-keyframes dot3 {
  80% {
    left: 78rpx;
  }
  100% {
    left: 88rpx;
    transform: scale(0.4, 0.4);
  }
}
@keyframes dot3 {
  80% {
    left: 78rpx;
  }
  100% {
    left: 88rpx;
    transform: scale(0.4, 0.4);
  }
}
.shake {
  animation: shake 0.4s;
}
@-webkit-keyframes shake {
  10%,
  90% {
    transform: translate3d(-6rpx, 0, 0);
  }
  20%,
  80% {
    transform: translate3d(6rpx, 0, 0);
  }
  30%,
  50%,
  70% {
    transform: translate3d(-6rpx, 0, 0);
  }
  40%,
  60% {
    transform: translate3d(6rpx, 0, 0);
  }
}
@keyframes shake {
  10%,
  90% {
    transform: translate3d(-6rpx, 0, 0);
  }
  20%,
  80% {
    transform: translate3d(6rpx, 0, 0);
  }
  30%,
  50%,
  70% {
    transform: translate3d(-6rpx, 0, 0);
  }
  40%,
  60% {
    transform: translate3d(6rpx, 0, 0);
  }
}
@media screen and (min-width: 480px) and (min-height: 480px) {
  .pre-captcha {
    height: 110px;
    width: 110px;
  }
  .dots-item {
    height: 10px;
    margin: 0 6px;
    width: 10px;
  }
  .captcha {
    border-radius: 5px;
    padding: 10px;
    width: 360px;
  }
  .captcha-header {
    font-size: 13px;
    height: 15px;
  }
  .captcha-title-warp {
    height: 40px;
  }
  .captcha-title {
    font-size: 18px;
  }
  .btn-close {
    height: 22px;
    right: 10px;
    top: 10px;
    width: 22px;
  }
  .captcha-fg-item__img {
    height: 14px;
    width: 20px;
  }
  .captcha-click-mark {
    border-width: 2px;
    height: 20px;
    width: 20px;
  }
  .captcha-click-number {
    font-size: 15px;
  }
  .captcha-footer {
    margin-top: 5px;
  }
  .error-text {
    font-size: 15px;
  }
  .btn-refresh {
    height: 20px;
    margin-right: 5px;
    width: 20px;
  }
  .btn-verify {
    border-radius: 4px;
    font-size: 14px;
    height: 29px;
    margin-left: 6px;
    width: 60px;
  }
  .load-error-text {
    font-size: 15px;
  }
  .load-error-icon {
    height: 27px;
    margin-top: 9px;
    width: 38px;
  }
  .verify-error-icon {
    height: 27px;
    width: 35px;
  }
  .verify-error-text {
    font-size: 17px;
    margin: 15px 9px;
  }
  .cover-success-img {
    height: 60px;
    width: 110px;
  }
  .cover-success-text {
    font-size: 17px;
    margin-top: 14px;
  }
  .loading-dots {
    width: 64px;
  }
  .loading-dot {
    height: 10px;
    width: 10px;
  }
  .dot0 {
    left: 10px;
  }
  .dot1 {
    left: 14px;
  }
  .dot2 {
    left: 27px;
  }
  .dot3 {
    left: 38px;
  }
  @-webkit-keyframes dot0 {
    to {
      left: 14px;
      transform: scale(1, 1);
    }
  }
  @keyframes dot0 {
    to {
      left: 14px;
      transform: scale(1, 1);
    }
  }
  @-webkit-keyframes dot1 {
    to {
      left: 26px;
    }
  }
  @keyframes dot1 {
    to {
      left: 26px;
    }
  }
  @-webkit-keyframes dot2 {
    to {
      left: 39px;
    }
  }
  @keyframes dot2 {
    to {
      left: 39px;
    }
  }
  @-webkit-keyframes dot3 {
    80% {
      left: 39px;
    }
    100% {
      left: 44px;
      transform: scale(0.4, 0.4);
    }
  }
  @keyframes dot3 {
    80% {
      left: 39px;
    }
    100% {
      left: 44px;
      transform: scale(0.4, 0.4);
    }
  }
}
@-webkit-keyframes shake {
  10%,
  90% {
    transform: translate3d(-3px, 0, 0);
  }
  20%,
  80% {
    transform: translate3d(3px, 0, 0);
  }
  30%,
  50%,
  70% {
    transform: translate3d(-3px, 0, 0);
  }
  40%,
  60% {
    transform: translate3d(3px, 0, 0);
  }
}
@keyframes shake {
  10%,
  90% {
    transform: translate3d(-3px, 0, 0);
  }
  20%,
  80% {
    transform: translate3d(3px, 0, 0);
  }
  30%,
  50%,
  70% {
    transform: translate3d(-3px, 0, 0);
  }
  40%,
  60% {
    transform: translate3d(3px, 0, 0);
  }
}
