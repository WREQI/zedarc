<view class="pre-captcha" wx:if="{{!isShowCaptcha}}">
  <view class="dots-item" style="background-color:{{themeRgbaColor}};"></view>
  <view class="dots-item" style="background-color:{{themeRgbaColor}};"></view>
  <view class="dots-item" style="background-color:{{themeRgbaColor}};"></view>
</view>
<view class="captcha" wx:if="{{isShowCaptcha}}">
  <view class="captcha-header">{{title}}</view>
  <view class="captcha-title-warp">
    <text class="captcha-title">{{instruction}}</text>
    <block wx:if="{{insStyles.length}}">
      <view
        style="background-image:url({{spriteConfig.url}});width:{{item.width}};height:{{item.height}};background-size:{{spriteConfig.size}};background-position:{{item.pos}}"
        wx:for="{{insStyles}}"
        wx:key="bgTop"
      ></view>
    </block>
  </view>
  <image
    catchtap="destroy"
    class="btn-close"
    src="data:image/png;base64,"
  ></image>
  <view class="captcha-body {{animateName}}">
    <view class="bg-area">
      <image
        class="placeholder-img"
        mode="widthFix"
        src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAFAQMAAACzVGSbAAAAA1BMVEVHcEyC+tLSAAAAAXRSTlMAQObYZgAAAAtJREFUCNdjYIABAAAKAAHn+Nr6AAAAAElFTkSuQmCC"
      ></image>
      <view
        catchtap="handleBgClick"
        class="bg-img"
        id="bgImg"
        style="height:{{bgStyles.height}};background:{{bgStyles.url?'url('+bgStyles.url+')':'transparent'}};background-position:{{bgStyles.pos}};background-size:{{bgStyles.size}};background-repeat:no-repeat"
      ></view>
    </view>
    <view class="cover loading-cover" hidden="{{!requesting}}">
      <view class="loading-dots">
        <view class="loading-dot dot0"></view>
        <view class="loading-dot dot1"></view>
        <view class="loading-dot dot2"></view>
        <view class="loading-dot dot3"></view>
      </view>
    </view>
    <view
      catchtap="refresh"
      class="cover tip-cover load-error-cover"
      hidden="{{!showLoadFailCover}}"
    >
      <view class="load-error-text">{{statusLoadFailText}}</view>
      <image
        class="load-error-icon"
        mode="aspectFit"
        src="data:image/png;base64,"
      ></image>
    </view>
    <view class="cover tip-cover" hidden="{{!showVerifyErrorCover}}">
      <image
        class="verify-error-icon"
        mode="aspectFit"
        src="data:image/png;base64,"
      ></image>
      <view class="verify-error-text">{{verifyErrorText}}</view>
      <view class="verify-error-sid" hidden="{{!sid}}">{{sid}}</view>
    </view>
    <view class="cover tip-cover" hidden="{{!showSuccessCover}}">
      <image
        class="cover-success-img"
        mode="aspectFit"
        src="data:image/png;base64,"
      ></image>
      <view class="cover-success-text">{{statusSuccessText}}</view>
    </view>
    <block wx:if="{{dragElCfg.length}}">
      <view
        bindtouchend="onTouchEnd"
        bindtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        class="captcha-fg-item {{item.className}}"
        data-id="{{item.id}}"
        data-index="{{index}}"
        data-move-cfg="{{item.moveCfg}}"
        data-slave-id="{{item.slaveId}}"
        style="background:{{item.className==='slider'?themeRgbaColor:'url('+spriteConfig.url+')'}};box-shadow:{{item.boxShadow}};background-size:{{spriteConfig.size}};background-position:{{item.pos}};width:{{item.width}}px;height:{{item.height}}px;top:{{item.top}}px;left:{{item.left}}px;z-inde:{{index+1}}"
        wx:for="{{dragElCfg}}"
        wx:key="pos"
      >
        <image
          class="captcha-fg-item__img"
          mode="aspectFit"
          src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACgAAAAcAgMAAABuexVFAAAACVBMVEUAAADCwsL9/f1P0DqbAAAAAXRSTlMAQObYZgAAAB1JREFUGNNjCGVgYGANABKhyMwoEHMBkIgaZWIwAdyJJQnaJRg5AAAAAElFTkSuQmCC"
          wx:if="{{item.className==='slider'}}"
        ></image>
      </view>
    </block>
    <block wx:if="{{clickElCfg.length}}">
      <view
        catchtap="cancelClickEl"
        class="captcha-click-mark"
        data-index="{{index}}"
        style="background:{{themeRgbaColor}};top:{{item.top}};left:{{item.left}}"
        wx:for="{{clickElCfg}}"
        wx:key="data"
      >
        <text
          class="captcha-click-number"
          wx:if="{{item.contentType==='number'}}"
          >{{item.content}}</text
        >
      </view>
    </block>
  </view>
  <view class="captcha-footer">
    <view class="captcha-footer__left">
      <view class="error-text" hidden="{{!statusFailText}}"
        >{{statusFailText}}</view
      >
    </view>
    <view class="captcha-footer__right">
      <image
        catchtap="refresh"
        class="btn-refresh"
        src="data:image/png;base64,"
      ></image>
      <view
        bindtap="handleClickVerify"
        class="btn-verify"
        style="background:{{themeRgbaColor}}"
        wx:if="{{showVerifyBtn}}"
        >{{btnVerifyText}}</view
      >
    </view>
  </view>
</view>
