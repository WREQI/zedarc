<view>
  <view
    class="{{['network-detect-result-wrap',p&&'network-detect-result-wrap__embedded',q&&'network-detect-result-wrap__full',r&&'network-detect-result-wrap__navbar']}}"
  >
    <popup
      bind:__l="__l"
      uI="edba1742-0"
      uP="{{o}}"
      uS="{{['d']}}"
      wx:if="{{o}}"
    >
      <view class="{{['network-detect-component',l,m]}}" style="{{n}}">
        <view class="top-wrap">
          <view class="top-wrap-center"></view>
          <view bindtap="{{b}}" class="top-wrap-close">
            <view class="close-bg" wx:if="{{a}}"></view>
          </view>
        </view>
        <view class="tools-network">
          <view class="tools-network__container">
            <view class="tools-network__image-wrap">
              <image class="icon" src="{{c}}"></image>
            </view>
            <view class="tools-network__tips">
