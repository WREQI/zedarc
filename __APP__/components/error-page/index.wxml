<view
  class="error-page-container"
  hidden="{{errorCode===SUCCESS_ERROR_CODE||!useErrorPage}}"
>
  <view class="error-message">{{errorMessage||'some error occurred'}}</view>
  <view class="error-button-container">
    <button class="error-button" openType="feedback" wx:if="{{useFeedback}}">
      反馈问题
    </button>
    <view class="retry-button-container" wx:else>
      <image
        class="retry-icon"
        src="data:image/png;base64,"
      ></image>
      <button bind:tap="onRefreshBtnTap" class="error-button">刷新试试</button>
    </view>
  </view>
  <view class="error-code-container">
    <view>错误码：{{errorCode}}</view>
    <view>{{guid}}</view>
  </view>
</view>
