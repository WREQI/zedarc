.error-page-container {
  align-items: center;
  background-color: #111;
  box-sizing: border-box;
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100%;
  justify-content: center;
  left: 0;
  padding: 0 16px;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 10;
}
.error-message {
  background-color: #111;
  color: #fff;
  font-size: 14px;
  font-weight: 400;
  text-align: center;
}
.error-button-container,
.error-message {
  line-height: 22px;
}
.retry-button-container {
  align-items: center;
  display: -webkit-flex;
  display: flex;
  gap: 4px;
  justify-content: center;
  line-height: 22px;
}
.retry-icon {
  height: 20px;
  width: 20px;
}
.error-button {
  background-color: #111;
  color: #999;
  font-size: 14px;
  font-weight: 500;
  line-height: 22px;
  padding: 0;
}
.error-code-container {
  bottom: 20px;
  color: #999;
  font-size: 10px;
  font-weight: 500;
  line-height: 16px;
  opacity: 0.5;
  position: absolute;
  text-align: center;
}
