@import "/app.wxss";
.bubble-tip {
  background: rgba(78, 85, 102, 0.8);
  border-radius: 0.053333rem;
  color: #fff;
  font-size: 0.426667rem;
  line-height: 0.56rem;
  padding: 0.213333rem 0.32rem;
}
[data-simple="true"] .bubble-tip {
  background: rgba(0, 0, 0, 0.6);
}
.bubble-tip:after {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/smooth-triangle.png);
  background-repeat: no-repeat;
  background-size: 100%;
  content: "";
  height: 0.213333rem;
  position: absolute;
  width: 0.506667rem;
}
[data-simple="true"] .bubble-tip:after {
  background-image: url(https://st.gtimg.com/image/mp-broker/trade/smooth-triangle-simple.png);
}
.bubble-tip.top-right:after {
  bottom: 100%;
  right: 0.213333rem;
}
.bubble-tip.top-left:after {
  bottom: 100%;
  left: 0.213333rem;
}
.bubble-tip.bottom-left:after {
  left: 0.213333rem;
}
.bubble-tip.bottom-left:after,
.bubble-tip.bottom-right:after {
  top: 100%;
  transform: rotate(180deg);
}
.bubble-tip.bottom-right:after {
  right: 0.213333rem;
}
.bubble-tip.bottom-center:after {
  right: 0.213333rem;
  top: 100%;
}
.bubble-tip.top-center:after {
  bottom: 100%;
  right: 50%;
  transform: translate(50%);
}
.bubble-tip .close-box {
  margin-left: 0.213333rem;
  text-align: center;
}
.bubble-tip .close-box .icon-close {
  font-size: 0.32rem;
}
