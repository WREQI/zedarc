<view>
  <mp-dialog
    bind:__l="__l"
    id="{{c}}"
    uI="2e02f5b8-0"
    uP="{{d}}"
    uS="{{['d']}}"
    wx:if="{{d}}"
  >
    <view class="mp-dialog__message">
      <view class="risk-title align-c">可转债停止交易和转股风险</view>
      <view class="risk-text"
