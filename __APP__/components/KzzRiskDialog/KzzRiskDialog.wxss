@import "/app.wxss";
.risk-title {
  color: var(--text-color-1);
  font-size: 0.48rem;
  font-weight: 500;
  line-height: 0.666667rem;
  margin-bottom: 0.293333rem;
  text-align: left;
}
.risk-text {
  color: #262e40;
  font-size: 0.426667rem;
  font-weight: 400;
  line-height: 0.56rem;
  text-align: justify;
}
[data-theme="dark"] .risk-text {
  color: var(--text-color-1);
}
.risk-text .fw-500 {
  font-weight: 500;
}
