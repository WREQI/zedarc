@import "/app.wxss";
.trade-container-root {
  padding-bottom: env(safe-area-inset-bottom);
}
.trade-container-root.external-nav-padding-fix {
  padding-bottom: calc(1.333333rem + env(safe-area-inset-bottom));
}
.trade-container-root--embedded {
  padding-bottom: 0;
}
.trade-container-root .st-segment-item {
  border: 1px solid var(--color-primary-1);
  border-left-width: 0;
  color: var(--color-primary-1);
}
.trade-container-root .st-segment-item:first-child {
  border-left-width: 1px;
  border-radius: 2px 0 0 2px;
}
.trade-container-root .st-segment-item:last-child {
  border-radius: 0 2px 2px 0;
}
.trade-container-root .st-segment-item-selected {
  background: var(--color-primary-1);
  color: #fff;
}
.trade-container-root[data-simple="true"][data-zero-bottom="true"] {
  padding-bottom: 0 !important;
}
.trade-container-root[data-simple="true"].trade-container-root--embedded {
  background-color: var(--fill-2);
  border-top-left-radius: 0.213333rem;
  border-top-right-radius: 0.213333rem;
  min-height: auto;
}
